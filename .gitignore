.venv/
# a spill folder named here (--compute temp_directory=.tmp); by default DuckDB spills to the system's temporary folder
.tmp/
__pycache__/
*.egg-info/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# pytest-split's times, when --store-durations is run without --durations-path tests/durations.json (CONTRIBUTING.md)
.test_durations

# a file written beside itself and renamed over it (er.io.replace_text, folder.stage), left by a write cut short
*.tmp

# Generated data: rebuilt by scripts/generate.py.
# data/reference/ stays tracked: the generator's frozen snapshot of public sources (see its SOURCES.md).
data/medallion/bronze/
data/medallion/gold/
data/labels/
data/artifacts/

# People's runs (python -m er build … --out workspaces/…): their records and results, never committed
workspaces/

# one writer at a time (er.folder.run_lock)
.*.lock

# Terraform: the providers it downloads, and the variables people fill in (deploy/terraform/*.tfvars.example are the forms)
deploy/terraform/.terraform/
deploy/terraform/*.tfvars
