.venv/
# a spill folder named here (--compute temp_directory=.tmp); by default DuckDB spills to the system's temporary folder
.tmp/
__pycache__/
*.egg-info/
.DS_Store
Thumbs.db

# the name model written beside itself and renamed over it, left by a write cut short
*.tmp.npz

# Generated data: rebuilt by scripts/generate.py.
# data/reference/ stays tracked: the generator's frozen snapshot of public sources (see its SOURCES.md).
data/medallion/bronze/
data/labels/
data/artifacts/

# People's runs (python -m nayose build … --out workspaces/…): their records and results, never committed
workspaces/


# Terraform: the providers it downloads, and the variables people fill in (deploy/terraform/*.tfvars.example are the forms)
deploy/terraform/.terraform/
deploy/terraform/*.tfvars
