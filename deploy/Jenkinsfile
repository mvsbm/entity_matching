// Delivery of nayose to BigQuery, as docs/operations.md sets it up. GitHub Actions gates every pull request
// (.github/workflows/); this pipeline ships what main holds, the same commit from staging to prod:
//   Checks    every push: the lint and the fast tests
//   Staging   main: nayose made in staging's dataset (deploy/deploy.py: its functions, procedures and name model); then
//             the smoke test (deploy/smoke.py): a generated file built by BigQuery there and by DuckDB here, compared
//   Approve   a person promotes the commit; nothing reaches prod without one
//   Prod      the same commit made in prod's dataset, with prod's column mapping (the secret nayose-mapping)
//   Run       a build with JOB set does only this: one job in prod (deploy/run.py), with ARGS
// Every call runs as an account of the project it touches: nayose-deployer to make, nayose-runtime to run. Each
// credential is a Jenkins file credential: a Workload Identity Federation configuration where this Jenkins can issue
// OIDC tokens, else a service account key (docs/operations.md). Jenkins provides, as environment: STAGING_PROJECT,
// PROD_PROJECT, and APPROVERS (who may promote to prod); and, where Terraform's dataset and bucket variables were set,
// NAYOSE_DATASET (nayose otherwise) and NAYOSE_STAGING_BUCKET (STAGING_PROJECT-nayose-runs otherwise).
pipeline {
  agent none
  options {
    disableConcurrentBuilds()  // one delivery at a time: two would race to make the procedures
  }
  environment {
    DATASET = "${env.NAYOSE_DATASET ?: 'nayose'}"  // the run's dataset in each project (Terraform's dataset)
    STAGING_BUCKET = "${env.NAYOSE_STAGING_BUCKET ?: env.STAGING_PROJECT + '-nayose-runs'}"  // Terraform's bucket
  }
  parameters {
    choice(name: 'JOB', choices: ['none', 'build', 'update', 'decide', 'match', 'undo', 'lookup'], description: 'only run this job in prod, with ARGS (no checks, no deploy)')
    string(name: 'ARGS', defaultValue: '', description: 'its arguments, space-separated: gs://… input files, or match\'s threshold; lookup\'s --record ID or COLUMN=VALUE (no spaces); undo takes none')
  }
  stages {
    stage('Checks') {
      when { expression { params.JOB == 'none' } }
      agent any
      steps {
        sh '''
          python3 -m venv .venv
          .venv/bin/python -m pip install --quiet -r requirements.txt
          .venv/bin/ruff check .
          .venv/bin/python -m pytest -n auto -q
        '''
      }
    }
    stage('Staging') {
      when { allOf { branch 'main'; expression { params.JOB == 'none' } } }
      agent any
      steps {
        withCredentials([file(credentialsId: 'nayose-staging-deployer', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
          sh '''
            python3 -m venv .venv
            .venv/bin/python -m pip install --quiet -r requirements.txt -r deploy/requirements.txt
            .venv/bin/python deploy/deploy.py "$STAGING_PROJECT.$DATASET"
          '''
        }
        withCredentials([file(credentialsId: 'nayose-staging-runtime', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
          sh '''
            export CLOUDSDK_CONFIG="$WORKSPACE/.gcloud-staging"
            gcloud auth login --cred-file="$GOOGLE_APPLICATION_CREDENTIALS" --quiet
            .venv/bin/python scripts/generate.py --entities 2000 --seed 7 --out smoke
            gcloud storage cp smoke/records.parquet "gs://$STAGING_BUCKET/in/smoke.parquet" --project="$STAGING_PROJECT"
            .venv/bin/python deploy/smoke.py "$STAGING_PROJECT.$DATASET" "gs://$STAGING_BUCKET/in/smoke.parquet" smoke/records.parquet
          '''
        }
      }
    }
    stage('Approve') {
      when { allOf { branch 'main'; expression { params.JOB == 'none' } } }
      steps {
        timeout(time: 7, unit: 'DAYS') {  // no agent held while a person decides
          input message: "Make ${env.GIT_COMMIT} in prod? Staging passed its smoke test.", ok: 'Make it in prod', submitter: env.APPROVERS
        }
      }
    }
    stage('Prod') {
      when { allOf { branch 'main'; expression { params.JOB == 'none' } } }
      agent any
      steps {
        withCredentials([file(credentialsId: 'nayose-prod-deployer', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
          sh '''
            export CLOUDSDK_CONFIG="$WORKSPACE/.gcloud-prod"
            gcloud auth login --cred-file="$GOOGLE_APPLICATION_CREDENTIALS" --quiet
            python3 -m venv .venv
            .venv/bin/python -m pip install --quiet -r requirements.txt -r deploy/requirements.txt
            gcloud secrets versions access latest --secret=nayose-mapping --project="$PROD_PROJECT" > mapping.sql
            .venv/bin/python deploy/deploy.py "$PROD_PROJECT.$DATASET" --mapping mapping.sql
            rm -f mapping.sql
          '''
        }
      }
    }
    stage('Run') {
      when { allOf { branch 'main'; expression { params.JOB != 'none' } } }  // prod's jobs from main alone, one at a time (disableConcurrentBuilds)
      agent any
      steps {
        withCredentials([file(credentialsId: 'nayose-prod-runtime', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
          sh '''
            set +x  # a lookup's ARGS may hold a record's values: the console shows no command
            python3 -m venv .venv
            .venv/bin/python -m pip install --quiet -r requirements.txt -r deploy/requirements.txt
            if [ "$JOB" = lookup ]; then  # typed values mapped, and the run's method checked, with prod's mapping
              trap 'rm -f mapping.sql' EXIT
              export CLOUDSDK_CONFIG="$WORKSPACE/.gcloud-run"
              gcloud auth login --cred-file="$GOOGLE_APPLICATION_CREDENTIALS" --quiet
              gcloud secrets versions access latest --secret=nayose-mapping --project="$PROD_PROJECT" > mapping.sql
              export NAYOSE_MAPPING="$PWD/mapping.sql"
            fi
            .venv/bin/python deploy/run.py "$PROD_PROJECT.$DATASET" "$JOB" $ARGS > report.txt
          '''
          archiveArtifacts artifacts: 'report.txt', allowEmptyArchive: true  // build's and update's: no record's value in it
        }
      }
    }
  }
}
