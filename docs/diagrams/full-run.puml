@startuml full-run
title LLD 1 · A full run: Run.full, its reports written with it (nayose resolve records … ~--workspace …)
skinparam defaultFontSize 11
skinparam rectangle {
  BackgroundColor #F4F6F8
  BorderColor #65717E
}
skinparam database {
  BackgroundColor #E8F1FB
  BorderColor #2C6DB3
}
skinparam file {
  BackgroundColor #FFF8E6
  BorderColor #B07D00
}

package "inputs" {
  file "the input: the files given, read as they come (inputs/)" as f_input
  file "config/final.toml · config/settings.toml" as f_config
  file "config/kind_names.npz: the name model" as f_names
  file "apply answers · kind_answers/part-n.parquet" as f_answers
  file "decisions/part-n.parquet" as f_decisions
}


rectangle "<b>1 · Load</b>: read the file, check it, standardize each record, and tell persons from companies\n<i>O(N·L)</i>\n<size:10><color:#65717E>Run.load · Run._answers · folder.answer_parts · Run._given · source.filled</color></size>\n<size:10><color:#65717E>source.open_source · source.suggest · settings.present_fields · settings.fit_to_file</color></size>\n<size:10><color:#65717E>Run._set_aside · Run._set_aside_in_order · kind.classifier · source.answers · source.known · kind.merge_answers · standardize.prepare · source.file_facts · Run._placeholders · Run._lacks</color></size>\n<size:10><color:#65717E>Run._prepared_key · kind.century · folder.prepared · Run._kept · folder.forget_prepared · folder.keep_prepared · io.alive · io.read_parquet</color></size>" as load
package "every step after load reads records" as after_load {
  rectangle "<b>2 · Budget</b>: count every key's pairs before any join; flag blocks too big to join blind\n<i>O(N) per key</i>\n<size:10><color:#65717E>Run.budget · candidates.estimate · Run.capacity · Run.spill_room · run.size_bytes</color></size>" as budget
  rectangle "<b>3 · Fit</b>: learn the model from the file itself, without labels; measure u on this file\n<i>O(n + S·K + P_em·K) + O(N + S·K)</i>\n<size:10><color:#65717E>Run.fit · match.train_fs · match.scored_u</color></size>\n<size:10><color:#65717E>match.u_basis · match.read_by · match.fs_settings · config.keys_sql</color></size>" as fit
  rectangle "<b>4 · Rules</b>: join the certain cases, the first rule wins; score each pair with the model; cluster them (they steer the candidates)\n<i>O(N + ΣP_r·L²) + O(R·K) + O(E·d + N)</i>\n<size:10><color:#65717E>Run.rules · Run._rules · Run._untrusted · match.rule_edges · match.score_fs · cluster.merge · source.filled</color></size>" as rules
  rectangle "<b>5 · Candidates</b>: list the pairs worth scoring; check big blocks on a sample\n<i>O(N·L + ΣP_g)</i>\n<size:10><color:#65717E>Run.candidates · run.listed · candidates.candidates · Run._gate · Run._scored · match.score_fs · match.cheap_comparisons · Run._gated · Run._joined</color></size>\n<size:10><color:#65717E>match.review_floor · Run.capacity · Run.spill_room · run.size_bytes</color></size>" as candidates
  rectangle "<b>6 · Score</b>: give every candidate pair that can reach 0 its evidence in bits, the rest left below 0 by a bound, a million at a time, saying how far it is; count the patterns they fall in\n<i>O(C·K·L²)</i>\n<size:10><color:#65717E>Run.score · Run._scored · match.score_fs · match.cheap_comparisons · Run._patterns · Run._bands · results.banded · match.named_sql · match.review_floor</color></size>" as score
  rectangle "<b>7 · Cluster</b>: merge the rules' and the model's pairs at the trust line (none set: every rule pair, and the model's at its threshold with a name compared), or, with the workspace's merge conditions, the pairs that meet them; people's matches, less their no_match; join them into entities, from single records\n<i>O(C + E·d + N)</i>\n<size:10><color:#65717E>Run._load_decisions · Run.cluster · Run._accept · Run.scored · match.named_sql · Run._links · results.merge_where</color></size>\n<size:10><color:#65717E>cluster.merge · Run._gold · run.customer_kinds · Run._expected_false</color></size>" as cluster
  rectangle "<b>7b · Probe</b>: the matches no key lists: pairs drawn within groups matches share (a phone, a postal area), scored; those at the line the likely links don't join, counted and scaled\n<i>O(N + P·K + L)</i>\n<size:10><color:#65717E>Run.probe · probe.missed</color></size>" as probe
  rectangle "<b>8 · Write</b>: save the answer, the pairs at 0 points or more with each comparison's level (scored/), the state for increments and the reports (9, built first); the old run goes only once all is written\n<i>O(N + C)</i>\n<size:10><color:#65717E>Run.write · Run._links · Run.scored · match.named_sql · folder.next_part · folder.stage · folder.finish_writes · folder.history · folder.brief · Run._log · folder.log · io.code_version · io.replace_text</color></size>\n<size:10><color:#65717E>the round its method is in: folder.round_ran · folder.rounds · folder.method · config.toml_of</color></size>" as write
  rectangle "<b>9 · Report</b>: the checks and the sheets for people, what they typed in and haven't given back kept, saved with the run (8)\n<i>O(review pairs) + O(N) in SQL</i>\n<size:10><color:#65717E>Run.report · report.qa · report.trust_sheet · report.trust_state · report.said · report.applied · report.fill_rates · match.review_floor · match.named_sql · report.review_sheet · report.households · report.carry_over</color></size>\n<size:10><color:#65717E>match.pattern_coverage · match.levels · io.markdown · kind.kind_review_sheet · report.carry_kinds</color></size>\n<size:10><color:#65717E>report.report_text · match.scaled_prior · match.parameters · config.sources_text · io.code_version · io.read_parquet</color></size>" as report
}
database "records" as records
database "set_aside" as set_aside
database "rule_clusters" as rule_clusters
database "rule_kept" as rule_kept
database "cands" as cands
database "scores" as scores
database "rule_scores" as rule_scores
database "matches" as matches
database "proposed" as proposed
database "kept" as kept
database "gold" as gold
database "er_decisions" as er_decisions

package "the workspace (~--workspace)" {
  file "gold.parquet · steps.json\nmatches/part-n.parquet · rule_kept/part-n.parquet\nproposed/part-n.parquet · set_aside/part-n.parquet\nscored/part-n.parquet: every pair at 0 points or more, each comparison's level" as f_out
  file "state/records/part-n.parquet · state/rule_clusters.parquet\nstate/model.json · state/scoring.json · state/placeholders.json · state/config.txt\nkind_answers/part-n.parquet: the sheet given, as given" as f_state
  file "qa.md · report.txt · review.parquet · kind_review.parquet" as f_people
}

f_input --> load
f_config --> load
f_names --> load
f_answers --> load
f_decisions --> cluster

load ..> budget
budget ..> fit
fit ..> rules
rules ..> candidates
candidates ..> score
score ..> cluster
cluster ..> probe
probe ..> write
write ..> report : built first, saved together

load --> records
load --> set_aside
records --> after_load
rules --> rule_clusters
rules --> rule_kept
rules --> rule_scores
rule_scores --> write
cands --> write
scores --> write
rule_clusters --> candidates
rule_clusters --> cluster
rule_clusters --> write
rule_kept --> write
rule_kept --> score
candidates --> cands
cands --> score
cands --> cluster
cands --> report
score --> scores
scores --> cluster
scores --> report
cluster --> matches
cluster --> proposed
cluster --> kept
cluster --> rule_kept
kept --> report
proposed --> write
cluster --> gold
matches --> write
matches --> report
gold --> write
gold --> report
set_aside --> write
set_aside --> report
cluster --> er_decisions
report --> er_decisions
er_decisions --> probe
matches --> probe
proposed --> probe
rule_kept --> probe

write --> f_out
write --> f_state
report --> f_people
legend right
  box: a step, what it does, its cost, and the code it runs
  cylinder: a working table · note: a file
  solid arrow: makes or uses · dashed arrow: runs next
endlegend
@enduml
