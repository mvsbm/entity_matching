@startuml containers
!include <C4/C4_Container>
LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()
title HLD 2 · Containers: the jobs and tools people run, the engine, and where everything is kept

Person(owner, "Data owner, reviewer", "runs the jobs; decides their pairs in a table or a sheet")
Person(developer, "Developer", "changes the method")

Container(runtime, "The jobs", "python -m er (er/__main__.py)", "build, update, decide, lookup; one JSON object printed; exit 2: a mistake to fix, 75: another job writing the run")
Container(designtime, "Design-time tools", "scripts/generate.py, scripts/train_name_model.py, scripts/benchmark.py", "synthetic data with the truth; the name model trained; the method measured")

System_Boundary(engine, "The engine, in one process") {
  Container(er, "er", "Python package", "every computation a run makes: the layers of HLD 3")
  Container(designpkg, "design", "Python package", "design time's code: the generator and the metrics; it reads er, never the reverse")
  Container(duckdb, "DuckDB", "in process", "the working tables, spilled to disk past memory_limit; every step's SQL, the scoring included; connected components by scipy")
}

ContainerDb(config, "config/", "TOML, npz", "settings.toml: the file's columns, [locale], [compute], [kind] · pipeline.toml: the method and kind_names.npz: the name model, the hand-off from design time")
ContainerDb(reference, "data/reference/", "JSON, in git", "public names, companies, addresses: the generator's input and the name model's training")
ContainerDb(runfolder, "The run's folder (~--out)", "Parquet, JSON, DuckDB", "gold.parquet, review.parquet, report.txt, steps.json, state/, index/: LLD 5")
ContainerDb(artifacts, "data/artifacts/", "Parquet, JSON", "the benchmark's runs")
ContainerDb(synthetic, "Synthetic data and reports", "Parquet, Markdown", "data/medallion/, data/labels/: records and their truth · reports/: what was measured")

Rel(owner, runtime, "runs")
Rel(developer, designtime, "runs")
Rel(runtime, er, "er.jobs: build, update, decide")
Rel(designtime, designpkg, "design.generate, design.evaluate")
Rel(designtime, er, "er.jobs, er.steps")
Rel(designpkg, er, "er.kind")
Rel(er, duckdb, "SQL on one connection")
Rel(er, config, "reads")
Rel(designpkg, reference, "reads")
Rel(er, runfolder, "reads, writes (staged, one writer)")
Rel(designtime, artifacts, "the benchmark's runs")
Rel(designtime, synthetic, "writes")
Rel(designtime, config, "writes kind_names.npz")

SHOW_LEGEND()
@enduml
