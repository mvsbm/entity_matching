@startuml context
!include <C4/C4_Context>
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
title 1 · Context: who uses nayose, and where its SQL runs

Person(developer, "Developer", "changes the SQL or config.toml, measures the change on synthetic data, opens a pull request")
Person(owner, "Data owner", "starts the jobs in prod: build, update, decide, match")
Person(reviewer, "Reviewer", "decides a match table's pairs, in a BigQuery table or a Sheet")
Person(devops, "DevOps team", "applies deploy/terraform/, holds the credentials and the column mapping")

System_Boundary(repo, "nayose (this repository)") {
  System(nayose, "nayose", "the method as BigQuery SQL (nayose/sql/), its values (config.toml), the jobs, the deploy")
}

System_Ext(github, "GitHub Actions", "every pull request: lint, the tests, the Terraform checked")
System_Ext(jenkins, "Jenkins", "deploy/Jenkinsfile: staging, smoke test, a person's approval, prod; then one job at a time")
System_Ext(bigquery, "BigQuery", "prod and staging: a run is the dataset nayose, its tables, functions and procedures")
System_Ext(storage, "Cloud Storage and Secret Manager", "the jobs' input files (gs://…/in/); the deployment's mapping.sql (nayose-mapping)")
System_Ext(duckdb, "DuckDB", "a laptop or CI: the same SQL, translated; a run is a folder")
System_Ext(downstream, "Downstream systems", "take each record's entity: gold")

Rel(developer, nayose, "changes", "pull request")
Rel(nayose, github, "is checked by")
Rel(developer, duckdb, "runs the jobs and the benchmark on", "python -m nayose")
Rel(nayose, jenkins, "main is shipped by")
Rel(owner, jenkins, "starts a job", "JOB, ARGS")
Rel(devops, storage, "sets up", "deploy/terraform/")
Rel(jenkins, bigquery, "deploys to, calls", "deploy/deploy.py, deploy/run.py")
Rel(bigquery, storage, "loads input from", "gs://…/in/")
Rel(jenkins, storage, "reads the mapping from", "nayose-mapping")
Rel(bigquery, reviewer, "gives a match table to", "matched")
Rel(reviewer, bigquery, "gives decisions back to", "decide")
Rel(bigquery, downstream, "gives", "gold")
SHOW_LEGEND()
@enduml
