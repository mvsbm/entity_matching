ce=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="4765" width="340" height="28" as="geometry"/></mxCell><mxCell id="v512" value="Embeddings (questions for Google)" style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="910" y="4543" width="870" height="22" as="geometry"/></mxCell><mxCell id="v513" value="Variable" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="4569" width="110" height="28" as="geometry"/></mxCell><mxCell id="v514" value="What it is" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1020" y="4569" width="400" height="28" as="geometry"/></mxCell><mxCell id="v515" value="Question" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1420" y="4569" width="360" height="28" as="geometry"/></mxCell><mxCell id="v516" value="Columns, T_n, T_a" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="4597" width="110" height="28" as="geometry"/></mxCell><mxCell id="v517" value="which columns go into each text, and their tokens" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="4597" width="400" height="28" as="geometry"/></mxCell><mxCell id="v518" value="Which columns are joined into each text?" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="4597" width="360" height="28" as="geometry"/></mxCell><mxCell id="v519" value="c_tok, a, D" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="4625" width="110" height="28" as="geometry"/></mxCell><mxCell id="v520" value="the model&#x27;s work per token, attention, vector size" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="4625" width="400" height="28" as="geometry"/></mxCell><mxCell id="v521" value="Which model and size? Is it 512 dimensions?" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="4625" width="360" height="28" as="geometry"/></mxCell><mxCell id="v522" value="I" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="4653" width="110" height="28" as="geometry"/></mxCell><mxCell id="v523" value="operations to add one vector to the index" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="4653" width="400" height="28" as="geometry"/></mxCell><mxCell id="v524" value="Which index type and settings?" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="4653" width="360" height="28" as="geometry"/></mxCell><mxCell id="v525" value="Q" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="4681" width="110" height="28" as="geometry"/></mxCell><mxCell id="v526" value="vectors one record is compared with in search" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="4681" width="400" height="28" as="geometry"/></mxCell><mxCell id="v527" value="How many vectors does a query visit?" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="4681" width="360" height="28" as="geometry"/></mxCell><mxCell id="v528" value="k" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="4709" width="110" height="28" as="geometry"/></mxCell><mxCell id="v529" value="neighbours kept per record as candidates" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="4709" width="400" height="28" as="geometry"/></mxCell><mxCell id="v530" value="How many neighbours per record?" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="4709" width="360" height="28" as="geometry"/></mxCell><mxCell id="v531" value="c_decide" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="4737" width="110" height="28" as="geometry"/></mxCell><mxCell id="v532" value="operations to decide one candidate" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="4737" width="400" height="28" as="geometry"/></mxCell><mxCell id="v533" value="How is “same customer” decided?" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="4737" width="360" height="28" as="geometry"/></mxCell><mxCell id="v534" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fffbe8;strokeColor=#d6b656;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="4813" width="1760" height="100" as="geometry"/></mxCell><mxCell id="v535" value="&lt;b&gt;Is the comparison fair yet?&lt;/b&gt;&lt;br&gt;Fair already: the same unit, per record, at the same N, from the same input (one name, one address).&lt;br&gt;&lt;br&gt;Not fair yet: our total runs to a decided score; the embedding total stops at the vectors. Both leave steps out, so both are lower bounds, for different reasons." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="4821" width="860" height="88" as="geometry"/></mxCell><mxCell id="v536" value="&lt;b&gt;Needed on both sides before comparing&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Same end point:&lt;/b&gt; both counted until a decided list of pairs.&lt;br&gt;• &lt;b&gt;Same quality:&lt;/b&gt; both reach the same pairs on the same records, e.g. 99.99% of reviewable pairs with no wrong merges.&lt;br&gt;• &lt;b&gt;One check:&lt;/b&gt; instructions counted on one CPU core, same records, both pipelines, so an operation means the same on both sides." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="910" y="4821" width="860" height="88" as="geometry"/></mxCell><mxCell id="e537" value="−1.37" style="endArrow=none;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="205" as="sourcePoint"/><mxPoint x="370" y="205" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e538" value="−1.37" style="endArrow=none;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="240" as="sourcePoint"/><mxPoint x="235" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e539" value="+11.28 ✓" style="endArrow=none;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="240" as="sourcePoint"/><mxPoint x="305" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e540" value="1-2 match" style="endArrow=none;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="2898" as="sourcePoint"/><mxPoint x="220" y="2883" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e541" value="1-3 match" style="endArrow=none;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="2923" as="sourcePoint"/><mxPoint x="225" y="2978" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e542" value="" style="endArrow=none;dashed=1;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="2918" as="sourcePoint"/><mxPoint x="255" y="2958" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e543" value="" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="2928" as="sourcePoint"/><mxPoint x="460" y="2928" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e544" value="" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="3704" as="sourcePoint"/><mxPoint x="465" y="3704" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e545" value="" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="3704" as="sourcePoint"/><mxPoint x="910" y="3704" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e546" value="" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="3704" as="sourcePoint"/><mxPoint x="1355" y="3704" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>