Geometry x="310" y="2261" width="60" height="27" as="geometry"/></mxCell><mxCell id="v303" value="−4.46" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="2261" width="110" height="27" as="geometry"/></mxCell><mxCell id="v304" value="set aside" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8d7da;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="2261" width="130" height="27" as="geometry"/></mxCell><mxCell id="v305" value="2-4" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2288" width="60" height="27" as="geometry"/></mxCell><mxCell id="v306" value="≠" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="2288" width="70" height="27" as="geometry"/></mxCell><mxCell id="v307" value="=" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160" y="2288" width="80" height="27" as="geometry"/></mxCell><mxCell id="v308" value="—" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="2288" width="70" height="27" as="geometry"/></mxCell><mxCell id="v309" value="≠" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="2288" width="60" height="27" as="geometry"/></mxCell><mxCell id="v310" value="−1.40" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="2288" width="110" height="27" as="geometry"/></mxCell><mxCell id="v311" value="set aside" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8d7da;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="2288" width="130" height="27" as="geometry"/></mxCell><mxCell id="v312" value="= same hash number · ≠ different · — missing on one side. 1-4 and 2-4 are the sibling: rightly set aside. 2-3 is set aside here, yet 2 and 3 still end up together (step 8)." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="2328" width="780" height="60" as="geometry"/></mxCell><mxCell id="v313" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="2408" width="1760" height="230" as="geometry"/></mxCell><mxCell id="v314" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;6. Read in full and score&lt;/b&gt;&lt;br&gt;Each label walks down its levels, best first; the first level that holds gives its points:&lt;br&gt;• names: Jaro-Winkler (≥ 0.95 very close, ≥ 0.75 close), plus same sound and same given name&lt;br&gt;• addresses: Levenshtein (≤ 2 letters changed), then same postcode&lt;br&gt;• phone: Hamming (1 digit off) · customer ID, birth date: Damerau-Levenshtein (1 digit off)&lt;br&gt;&lt;br&gt;Points add up; 0 or more is saved." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="2416" width="520" height="214" as="geometry"/></mxCell><mxCell id="v315" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="2416" width="1" height="214" as="geometry"/></mxCell><mxCell id="v316" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;Per pair: B²name + B²addr = 1165 byte comparisons&lt;br&gt;0.073 × 1165 ≈ 85 per record&lt;br&gt;&lt;br&gt;1M records: &lt;b&gt;0.6 s&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="2416" width="400" height="214" as="geometry"/></mxCell><mxCell id="v317" value="Pair 1-3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="2420" width="90" height="26" as="geometry"/></mxCell><mxCell id="v318" value="record 1" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="2420" width="170" height="26" as="geometry"/></mxCell><mxCell id="v319" value="record 3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="2420" width="190" height="26" as="geometry"/></mxCell><mxCell id="v320" value="comparison → level" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="2420" width="190" height="26" as="geometry"/></mxCell><mxCell id="v321" value="points" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="2420" width="80" height="26" as="geometry"/></mxCell><mxCell id="v322" value="start" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2446" width="90" height="26" as="geometry"/></mxCell><mxCell id="v323" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="2446" width="170" height="26" as="geometry"/></mxCell><mxCell id="v324" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="2446" width="190" height="26" as="geometry"/></mxCell><mxCell id="v325" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="2446" width="190" height="26" as="geometry"/></mxCell><mxCell id="v326" value="−23.68" style="whiteSpace=wrap;html=1;fontSize=11;align=cente