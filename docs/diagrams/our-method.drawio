ent="1"><mxGeometry x="150" y="1108" width="60" height="27" as="geometry"/></mxCell><mxCell id="v140" value="m" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="1108" width="40" height="27" as="geometry"/></mxCell><mxCell id="v141" value="Bunkyo-ku Hongo 1-2-3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="1108" width="220" height="27" as="geometry"/></mxCell><mxCell id="v142" value="1130033" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="1108" width="76" height="27" as="geometry"/></mxCell><mxCell id="v143" value="113" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1108" width="48" height="27" as="geometry"/></mxCell><mxCell id="v144" value="5678" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="594" y="1108" width="56" height="27" as="geometry"/></mxCell><mxCell id="v145" value="5" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1135" width="28" height="27" as="geometry"/></mxCell><mxCell id="v146" value="nasibin" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="58" y="1135" width="92" height="27" as="geometry"/></mxCell><mxCell id="v147" value="bin" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="1135" width="60" height="27" as="geometry"/></mxCell><mxCell id="v148" value="n" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="1135" width="40" height="27" as="geometry"/></mxCell><mxCell id="v149" value="Takasaki-shi 7-8" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="250" y="1135" width="220" height="27" as="geometry"/></mxCell><mxCell id="v150" value="3700001" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="1135" width="76" height="27" as="geometry"/></mxCell><mxCell id="v151" value="370" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="546" y="1135" width="48" height="27" as="geometry"/></mxCell><mxCell id="v152" value="9012" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="594" y="1135" width="56" height="27" as="geometry"/></mxCell><mxCell id="v153" value="Yellow: “Tokyo … 1-chome 2-3” became “Bunkyo-ku Hongo 1-2-3”, now equal to record 2&#x27;s." style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="1164" width="700" height="20" as="geometry"/></mxCell><mxCell id="v154" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="1198" width="1760" height="190" as="geometry"/></mxCell><mxCell id="v155" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;1. Budget&lt;/b&gt;&lt;br&gt;Before making any pair, count how many records share each tag value (a GROUP BY). This tells each tray&#x27;s size in advance.&lt;br&gt;&lt;br&gt;A value held by 64 or more records is a placeholder (phone 0000), not evidence: it counts as empty. Very big trays are marked for a sample check in step 5." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="1206" width="520" height="174" as="geometry"/></mxCell><mxCell id="v156" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="1206" width="1" height="174" as="geometry"/></mxCell><mxCell id="v157" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;One pass per tag kind:&lt;br&gt;O(N) each&lt;br&gt;&lt;br&gt;1M records: &lt;b&gt;1.8 s&lt;/b&gt;,&lt;br&gt;4.09M pairs foreseen" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="1206" width="400" height="174" as="geometry"/></mxCell><mxCell id="v158" value="Tag kind" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1210" width="190" height="27" as="geometry"/></mxCell><mxCell id="v159" value="Value" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="1210" width="250" height="27" as="geometry"/></mxCell><mxCell id="v160" value="Records" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="1210" width="120" height="27" as="geometry"/></mxCell><mxCell id="v161" value="Pairs it will make" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="1210" width="130" height="27" as="geometry"/></mxCell><mxCell id="v162" value="name" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1237" width="190" height="27" as="geometry"/></mxCell><mxCell id="v163" value="masungbin" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="220" y="1237" width="250" height="27" as="geometry"/></mxCell><mxCell id="v164" value="1, 2, 3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="1237" width="120" height="27" as="geometry"/></mxCell><mxCell id="v165" value="3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="1237" width="130" height="27" as="geometry"/></mxCell><mxCell id="v166" value="address + first letter" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1264" width="190" height="27" as="geometry"/></mxCell><mxCell id="v167" value="Bunkyo-ku Hongo 1-2-3 · m" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="220" y="1264" width="250" height="27" as="geometry"/></mxCell><mxCell id="v168" value="1, 2, 4" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="1264" width="120" height="27" as="geometry"/></mxCell><mxCell id="v169" value="3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="1264" width="130" height="27" as="geometry"/></mxCell><mxCell id="v170" value="phone + first letter" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1291" width="190" height="27" as="geometry"/></mxCell><mxCell id="v171" value="1234 · m" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="220" y="1291" width="250" height="27" as="geometry"/></mxCell><mxCell id="v172" value="1, 3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="1291" width="120" height="27" as="geometry"/></mxCell><mxCell id="v173" value="1" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="1291" width="130" height="27" as="geometry"/></mxCell><mxCell id="v174" value="all other values" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1318" width="190" height="27" as="geometry"/></mxCell><mxCell id="v175" value="…" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="220" y="1318" width="250" height="27" as="geometry"/></mxCell><mxCell id="v176" value="1 each" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="1318" width="120" height="27" as="geometry"/></mxCell><mxCell id="v177" value="0" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="1318" width="130" height="27" as="geometry"/></mxCell><mxCell id="v178" value="phone (in a big file)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1345" width="190" height="27" as="geometry"/></mxCell><mxCell id="v179" value="0000" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="220" y="1345" width="250" height="27" as="geometry"/></mxCell><mxCell id="v180" value="50,000" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="1345" width="120" height="27" as="geometry"/></mxCell><mxCell id="v181" value="treated as empty" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8d7da;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="590" y="1345" width="130" height="27" as="geometry"/></mxCell><mxCell id="v182" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="1398" width="1760" height="290" as="geometry"/></mxCell><mxCell id="v183" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;2. Learn the score card (Fellegi–Sunter)&lt;/b&gt;&lt;br&gt;Take a sample of 100,000 records (whole postal areas, so families stay together). For each label and level, learn:&lt;br&gt;• &lt;b&gt;m&lt;/b&gt;: how often it happens when two records are the same person. Learned by guess-and-check (EM) on pairs that share a phone, and on pairs that share an address: guess which are matches, recount, repeat until stable.&lt;br&gt;• &lt;b&gt;u&lt;/b&gt;: how often it happens by chance. Counted on the whole file: exact levels from value counts, the rest from 10⁶ random pairs.&lt;br&gt;• &lt;b&gt;λ&lt;/b&gt;: the chance two random records are one person, from the pairs the sure rules find.&lt;br&gt;Points = log₂(m / u). &lt;b&gt;Saved: state/model.json&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="1406" width="520" height="274" as="geometry"/></mxCell><mxCell id="v184" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="1406" width="1" height="274" as="geometry"/></mxCell><mxCell id="v185" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;Fixed, whatever N is:&lt;br&gt;10⁶ × 1165 = 1.165 × 10⁹&lt;br&gt;plus one pass over the file.&lt;br&gt;&lt;br&gt;1M records: &lt;b&gt;3.6 s&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="1406" width="400" height="274" as="geometry"/></mxCell><mxCell id="v186" value="Label and level" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1410" width="240" height="26" as="geometry"/></mxCell><mxCell id="v187" value="m (same person)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="1410" width="150" height="26" as="geometry"/></mxCell><mxCell id="v188" value="u (by chance)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="1410" width="150" height="26" as="geometry"/></mxCell><mxCell id="v189" value="points" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="1410" width="110" height="26" as="geometry"/></mxCell><mxCell id="v190" value="start (λ ≈ 1 in 13 million)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1436" width="240" height="26" as="geometry"/></mxCell><mxCell id="v191" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="1436" width="150" height="26" as="geometry"/></mxCell><mxCell id="v192" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="1436" width="150" height="26" as="geometry"/></mxCell><mxCell id="v193" value="−23.68" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1436" width="110" height="26" as="geometry"/></mxCell><mxCell id="v194" value="customer ID same" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1462" width="240" height="26" as="geometry"/></mxCell><mxCell id="v195" value="1.5%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="1462" width="150" height="26" as="geometry"/></mxCell><mxCell id="v196" value="0.000001%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="1462" width="150" height="26" as="geometry"/></mxCell><mxCell id="v197" value="+20.47" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1462" width="110" height="26" as="geometry"/></mxCell><mxCell id="v198" value="name same" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1488" width="240" height="26" as="geometry"/></mxCell><mxCell id="v199" value="24%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="1488" width="150" height="26" as="geome