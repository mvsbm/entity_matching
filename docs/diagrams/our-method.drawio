or=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1540" width="240" height="26" as="geometry"/></mxCell><mxCell id="v207" value="85%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="1540" width="150" height="26" as="geometry"/></mxCell><mxCell id="v208" value="0.098%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="1540" width="150" height="26" as="geometry"/></mxCell><mxCell id="v209" value="+9.76" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1540" width="110" height="26" as="geometry"/></mxCell><mxCell id="v210" value="name close (Jaro-Winkler ≥ 0.75)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1566" width="240" height="26" as="geometry"/></mxCell><mxCell id="v211" value="12%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="1566" width="150" height="26" as="geometry"/></mxCell><mxCell id="v212" value="0.19%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="1566" width="150" height="26" as="geometry"/></mxCell><mxCell id="v213" value="+5.97" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1566" width="110" height="26" as="geometry"/></mxCell><mxCell id="v214" value="address different" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1592" width="240" height="26" as="geometry"/></mxCell><mxCell id="v215" value="24%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="1592" width="150" height="26" as="geometry"/></mxCell><mxCell id="v216" value="99.9%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="1592" width="150" height="26" as="geometry"/></mxCell><mxCell id="v217" value="−2.04" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1592" width="110" height="26" as="geometry"/></mxCell><mxCell id="v218" value="phone different" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1618" width="240" height="26" as="geometry"/></mxCell><mxCell id="v219" value="12%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="1618" width="150" height="26" as="geometry"/></mxCell><mxCell id="v220" value="99.5%" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="1618" width="150" height="26" as="geometry"/></mxCell><mxCell id="v221" value="−3.06" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1618" width="110" height="26" as="geometry"/></mxCell><mxCell id="v222" value="a label missing on either side" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1644" width="240" height="26" as="geometry"/></mxCell><mxCell id="v223" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="270" y="1644" width="150" height="26" as="geometry"/></mxCell><mxCell id="v224" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="1644" width="150" height="26" as="geometry"/></mxCell><mxCell id="v225" value="0" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="1644" width="110" height="26" as="geometry"/></mxCell><mxCell id="v226" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="1698" width="1760" height="200" as="geometry"/></mxCell><mxCell id="v227" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;3. Tie the sure ones (12 rules)&lt;/b&gt;&lt;br&gt;Five exact rules (e.g. same customer ID + full name; same name + address code + phone) and seven that allow a small difference once an exact part matches (e.g. name within 2 edits + same address code + phone).&lt;br&gt;&lt;br&gt;A sure pair is scored too, so people see its points. Pairs inside one sure group are not listed again in step 4. In your workspaces a sure pair still waits for people unless a merge condition says otherwise." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="1706" width="520" height="184" as="geometry"/></mxCell><mxCell id="v228" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="1706" width="1" height="184" as="geometry"/></mxCell><mxCell id="v229" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;One hash join per rule:&lt;br&gt;O(N + rule pairs × L²)&lt;br&gt;&lt;br&gt;1M records: &lt;b&gt;1.1 s&lt;/b&gt;,&lt;br&gt;4,954 sure pairs" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="1706" width="400" height="184" as="geometry"/></mxCell><mxCell id="v230" value="Rule" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1710" width="70" height="27" as="geometry"/></mxCell><mxCell id="v231" value="Must be the same" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="1710" width="230" height="27" as="geometry"/></mxCell><mxCell id="v232" value="Tray" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="1710" width="230" height="27" as="geometry"/></mxCell><mxCell id="v233" value="Result" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="1710" width="120" height="27" as="geometry"/></mxCell><mxCell id="v234" value="X1" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1737" width="70" height="27" as="geometry"/></mxCell><mxCell id="v235" value="customer ID + full name" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="1737" width="230" height="27" as="geometry"/></mxCell><mxCell id="v236" value="10002345 · masungbin" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1737" width="230" height="27" as="geometry"/></mxCell><mxCell id="v237" value="1-2 sure" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dff0d8;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="1737" width="120" height="27" as="geometry"/></mxCell><mxCell id="v238" value="X4" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1764" width="70" height="27" as="geometry"/></mxCell><mxCell id="v239" value="full name + address code + phone" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="1764" width="230" height="27" as="geometry"/></mxCell><mxCell id="v240" value="(no address code here)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1764" width="230" height="27" as="geometry"/></mxCell><mxCell id="v241" value="—" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="1764" width="120" height="27" as="geometry"/></mxCell><mxCell id="v242" value="F1–F7" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1791" width="70" height="27" as="geometry"/></mxCell><mxCell id="v243" value="…" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="1791" width="230" height="27" as="geometry"/></mxCell><mxCell id="v244" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1791" width="230" height="27" as="geometry"/></mxCell><mxCell id="v245" value="—" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="1791" width="120" height="27" as="geometry"/></mxCell><mxCell id="v246" value="1-2 is scored: −23.68 + 18.63 (name) + 16.33 (address) + 20.47 (ID) = &lt;b&gt;+31.75&lt;/b&gt;; record 2 has no phone: 0." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="1830" width="700" height="40" as="geometry"/></mxCell><mxCell id="v247" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="1908" width="1760" height="250" as="geometry"/></mxCell><mxCell id="v248" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;4. Tags → trays&lt;/b&gt;&lt;br&gt;Every record writes up to 22 kinds of tags: name; name without dakuten; name as it sounds; name with one letter covered + area; given name + postcode / address code / phone; last 3 sounds + phone / postcode / area; address + first letter; address code + phone; phone + area / first letter; customer ID; ID with one digit covered; birth date; …&lt;br&gt;&lt;br&gt;Each tag is hashed to a tray number: equal tags always get equal numbers. Only records in one tray become pairs. &lt;b&gt;One record can be in many trays, so it can have many candidates:&lt;/b&gt; record 1 gets 2, 3 and 4." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="1916" width="520" height="234" as="geometry"/></mxCell><mxCell id="v249" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="1916" width="1" height="234" as="geometry"/></mxCell><mxCell id="v250" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;Each record&#x27;s tags written and hashed:&lt;br&gt;T ≈ 388 bytes per record&lt;br&gt;&lt;br&gt;1M records (steps 4–5): &lt;b&gt;3.2 s&lt;/b&gt;,&lt;br&gt;2.74M pairs listed = 2.7 per record" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="1916" width="400" height="234" as="geometry"/></mxCell><mxCell id="v251" value="Tray (tag · value)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1920" width="300" height="26" as="geometry"/></mxCell><mxCell id="v252" value="Records" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="1920" width="90" height="26" as="geometry"/></mxCell><mxCell id="v253" value="Pairs out" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="1920" width="190" height="26" as="geometry"/></mxCell><mxCell id="v254" value="name · masungbin" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1946" width="300" height="26" as="geometry"/></mxCell><mxCell id="v255" value="1, 2, 3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1946" width="90" height="26" as="geometry"/></mxCell><mxCell id="v256" value="1-2, 1-3, 2-3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="1946" width="190" height="26" as="geometry"/></mxCell><mxCell id="v257" value="name as it sounds · masungbin" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1972" width="300" height="26" as="geometry"/></mxCell><mxCell id="v258" value="1, 2, 3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1972" width="90" height="26" as="geometry"/></mxCell><mxCell id="v259" value="(repeats)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="1972" width="190" height="26" as="geometry"/></mxCell><mxCell id="v260" value="address + first letter · Hongo 1-2-3 · m" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1998" width="300" height="26" as="geometry"/></mxCell><mxCell id="v261" value="1, 2, 4" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="1998" width="90" height="26" as="geometry"/></mxCell><mxCell id="v262" value="1-2, 1-4, 2-4" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="1998" width="190" height="26" as="geometry"/></mxCell><mxCell id="v263" value="phone + first letter · 1234 · m" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2024" width="300" height="26" as="geometry"/></mxCell><mxCell id="v264" value="1, 3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2024" width="90" height="26" as="geometry"/></mxCell><mxCell id="v265" value="1-3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="2024" width="190" height="26" as="geometry"/></mxCell><mxCell id="v266" value="name, one letter covered + area 113" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2050" width="300" height="26" as="geometry"/></mxCell><mxCell id="v267" value="1, 2" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2050" width="90" height="26" as="geometry"/></mxCell><mxCell id="v268" value="1-2" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="2050" width="190" height="26" as="geometry"/></mxCell><mxCell id="v269" value="every other tray" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2076" width="300" height="26" as="geometry"/></mxCell><mxCell id="v270" value="1 record" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2076" width="90" height="26" as="geometry"/></mxCell><mxCell id="v271" value="none" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="2076" width="190" height="26" as="geometry"/></mxCell><mxCell id="v272" value="Drop 1-2 (already one sure group), cross out repeats → &lt;b&gt;4 pairs: 1-3, 2-3, 1-4, 2-4&lt;/b&gt;. Record 5 is never paired." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="2112" width="780" height="40" as="geometry"/></mxCell><mxCell id="v273" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="2168" width="1760" height="230" as="geometry"/></mxCell><mxCell id="v274" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;5. Glance (best case first)&lt;/b&gt;&lt;br&gt;Three quick passes, each assuming the &lt;b&gt;best&lt;/b&gt; for whatever it hasn&#x27;t read yet:&lt;br&gt;1. compare each label&#x27;s hash number: equal → maybe the same; different → surely not exactly the same;&lt;br&gt;2. read the quick labels: phone and ID digits, lengths;&lt;br&gt;3. work out the full best case.&lt;br&gt;&lt;br&gt;A pair is set aside only if even its best case is below 0. So a pair that could reach 0 is never set aside. Big trays from step 1 are joined only if a sample of their pairs could reach 0." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="2176" width="520" height="214" as="geometry"/></mxCell><mxCell id="v275" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="2176" width="1" height="214" as="geometry"/></mxCell><mxCell id="v276" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;Per pair: about 9 number comparisons and a few bytes, no full read.&lt;br&gt;&lt;br&gt;1M records: 2.74M pairs → &lt;b&gt;72,932&lt;/b&gt; kept (0.073 per record)" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="2176" width="400" height="214" as="geometry"/></mxCell><mxCell id="v277" value="Pair" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="2180" width="60" height="27" as="geometry"/></mxCell><mxCell id="v278" value="name #" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="2180" width="70" height="27" as="geometry"/></mxCell><mxCell id="v279" value="address #" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="2180" width="80" height="27" as="geometry"/></mxCell><mxCell id="v280" value="phone #" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="2180" width="70" height="27" as="geometry"/></mxCell><mxCell id="v281" value="ID #" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="2180" width="60" height="27" as="geometry"/></mxCell><mxCell id="v282" value="best case" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="2180" width="110" height="27" as="geometry"/></mxCell><mxCell id="v283" value="result" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="2180" width="130" height="27" as="geometry"/></mxCell><mxCell id="v284" value="1-3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2207" width="60" height="27" as="geometry"/></mxCell><mxCell id="v285" value="=" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="2207" width="70" height="27" as="geometry"/></mxCell><mxCell id="v286" value="≠" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160" y="2207" width="80" height="27" as="geometry"/></mxCell><mxCell id="v287" value="=" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="2207" width="70" height="27" as="geometry"/></mxCell><mxCell id="v288" value="—" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="2207" width="60" height="27" as="geometry"/></mxCell><mxCell id="v289" value="+2.67" style="whiteSpace=wrap;html=1;fontSize=11;align=center;v