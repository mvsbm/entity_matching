<mxfile host="app.diagrams.net"><diagram name="Our method" id="ours"><mxGraphModel grid="1" gridSize="10" math="1" page="1" pageWidth="1800" pageHeight="4953"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v2" value="Our method: blocking + score card" style="whiteSpace=wrap;html=1;fontSize=24;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1000" height="40" as="geometry"/></mxCell><mxCell id="v3" value="① The simple example: 10 balls, one tag (city + first letter of the name)" style="whiteSpace=wrap;html=1;fontSize=18;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#2b4c80;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="1720" height="28" as="geometry"/></mxCell><mxCell id="v4" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#2b4c80;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="86" width="1720" height="2" as="geometry"/></mxCell><mxCell id="v5" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="500" height="610" as="geometry"/></mxCell><mxCell id="v6" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="460" height="260" as="geometry"/></mxCell><mxCell id="v7" value="Tray: Bunkyo · m" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="52" y="122" width="300" height="20" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Ma Subin&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;Tokyo, Bunkyo-ku&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f2cfd0;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="90" height="90" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;Ma Sungbin&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;Tokyo, Bunkyo-ku&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e98f8f;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="160" width="90" height="90" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Ma Sungbin&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;Tokyo, Bunkyo-ku&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e98f8f;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="225" y="272" width="90" height="90" as="geometry"/></mxCell><mxCell id="v11" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="220" height="140" as="geometry"/></mxCell><mxCell id="v12" value="Tray: Kawasaki · m" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="52" y="396" width="200" height="20" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Ma Soubin&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;Kanagawa, Kawasaki-shi&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f0b55e;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="110" y="424" width="85" height="85" as="geometry"/></mxCell><mxCell id="v14" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="280" y="390" width="220" height="140" as="geometry"/></mxCell><mxCell id="v15" value="Tray: Takasaki · n" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="292" y="396" width="200" height="20" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;Na Sibin&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;Gunma, Takasaki-shi&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="424" width="85" height="85" as="geometry"/></mxCell><mxCell id="v17" value="5 more trays, one ball each" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="460" height="20" as="geometry"/></mxCell><mxCell id="v18" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="40" y="564" width="84" height="70" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="57" y="571" width="50" height="50" as="geometry"/></mxCell><mxCell id="v20" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="133" y="564" width="84" height="70" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="571" width="50" height="50" as="geometry"/></mxCell><mxCell id="v22" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="226" y="564" width="84" height="70" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="243" y="571" width="50" height="50" as="geometry"/></mxCell><mxCell id="v24" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="319" y="564" width="84" height="70" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="336" y="571" width="50" height="50" as="geometry"/></mxCell><mxCell id="v26" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="412" y="564" width="84" height="70" as="geometry"/></mxCell><mxCell id="v27" value="&lt;b&gt;&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="429" y="571" width="50" height="50" as="geometry"/></mxCell><mxCell id="v28" value="Lines only inside a tray: &lt;b&gt;3 lines instead of 45.&lt;/b&gt;&lt;br&gt;Only &lt;b&gt;+11.28 ✓&lt;/b&gt; reaches 0: the two Ma Sungbin balls go to people." style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="460" height="60" as="geometry"/></mxCell><mxCell id="v29" value="What the person does" style="whiteSpace=wrap;html=1;fontSize=16;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="520" height="24" as="geometry"/></mxCell><mxCell id="v30" value="0. Once, first: learn the score card from a sample of balls (right).&lt;br&gt;&lt;br&gt;1. Pick up each ball once and write its tag on a slip: its city + the first letter of its name.&lt;br&gt;&lt;br&gt;2. Drop each slip into the tray with the same tag (hashing). No two balls are held side by side yet.&lt;br&gt;&lt;br&gt;3. Pick up only balls that share a tray, and hold them next to each other.&lt;br&gt;&lt;br&gt;4. Read their names and addresses letter by letter and add up the points.&lt;br&gt;&lt;br&gt;5. Pairs at 0 points or more go to people, who decide." style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="560" y="128" width="520" height="240" as="geometry"/></mxCell><mxCell id="v31" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fffbe8;strokeColor=#d6b656;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="520" height="190" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;* We don&#x27;t need to compare every pair, since&lt;/b&gt;&lt;br&gt;1. two records of the same person almost always share something exactly. The trays find those pairs without comparing anything.&lt;br&gt;2. the score card already says how close is close enough: 0 points. Each pair is judged on its own, not against every other pair.&lt;br&gt;&lt;br&gt;&lt;b&gt;But:&lt;/b&gt; Ma Soubin lives in another city, so this one tag never puts it next to Ma Subin. The real run writes 22 kinds of tags (below): a shared phone, customer ID or birth date would put them in one tray." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="568" y="388" width="504" height="176" as="geometry"/></mxCell><mxCell id="v33" value="How each line gets its points" style="whiteSpace=wrap;html=1;fontSize=16;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="620" height="24" as="geometry"/></mxCell><mxCell id="v34" value="$$\text{points} = \log_2\frac{\lambda}{1-\lambda} + \sum_{\text{labels}} \log_2\frac{m}{u}$$" style="whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="130" width="620" height="40" as="geometry"/></mxCell><mxCell id="v35" value="&lt;b&gt;m&lt;/b&gt;: how often the label matches when two balls are the same person. &lt;b&gt;u&lt;/b&gt;: how often it matches by chance. &lt;b&gt;λ&lt;/b&gt;: the chance two random balls are the same person. Rare by chance = many points." style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1120" y="180" width="620" height="56" as="geometry"/></mxCell><mxCell id="v36" value="Label" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="244" width="250" height="30" as="geometry"/></mxCell><mxCell id="v37" value="m (same person)" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="244" width="130" height="30" as="geometry"/></mxCell><mxCell id="v38" value="u (by chance)" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1500" y="244" width="130" height="30" as="geometry"/></mxCell><mxCell id="v39" value="points" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1630" y="244" width="110" height="30" as="geometry"/></mxCell><mxCell id="v40" value="Start" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="274" width="250" height="30" as="geometry"/></mxCell><mxCell id="v41" value="λ ≈ 1 in 13 million" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="274" width="130" height="30" as="geometry"/></mxCell><mxCell id="v42" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="274" width="130" height="30" as="geometry"/></mxCell><mxCell id="v43" value="−23.68" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1630" y="274" width="110" height="30" as="geometry"/></mxCell><mxCell id="v44" value="Same name" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="304" width="250" height="30" as="geometry"/></mxCell><mxCell id="v45" value="24%" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="304" width="130" height="30" as="geometry"/></mxCell><mxCell id="v46" value="0.000059%" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="304" width="130" height="30" as="geometry"/></mxCell><mxCell id="v47" value="+18.63" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1630" y="304" width="110" height="30" as="geometry"/></mxCell><mxCell id="v48" value="Same address" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="334" width="250" height="30" as="geometry"/></mxCell><mxCell id="v49" value="53%" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="334" width="130" height="30" as="geometry"/></mxCell><mxCell id="v50" value="0.00065%" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="334" width="130" height="30" as="geometry"/></mxCell><mxCell id="v51" value="+16.33" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1630" y="334" width="110" height="30" as="geometry"/></mxCell><mxCell id="v52" value="Name close (Jaro-Winkler ≥ 0.75)" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="364" width="250" height="30" as="geometry"/></mxCell><mxCell id="v53" value="12%" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="364" width="130" height="30" as="geometry"/></mxCell><mxCell id="v54" value="0.19%" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="364" width="130" height="30" as="geometry"/></mxCell><mxCell id="v55" value="+5.97" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1630" y="364" width="110" height="30" as="geometry"/></mxCell><mxCell id="v56" value="$$\text{Ma Sungbin} \leftrightarrow \text{Ma Sungbin}: \; -23.68 + 18.63 + 16.33 = +11.28$$" style="whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="404" width="620" height="34" as="geometry"/></mxCell><mxCell id="v57" value="$$\text{Ma Subin} \leftrightarrow \text{Ma Sungbin}: \; -23.68 + 5.97 + 16.33 = -1.37$$" style="whiteSpace=wrap;html=1;fontSize=13;align=center;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="444" width="620" height="34" as="geometry"/></mxCell><mxCell id="v58" value="At 0 or more a pair goes to people; below 0 it is set aside.&lt;br&gt;These m, u and λ were learned on a generated 1M-record file; a run learns its own from the file it reads." style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1120" y="490" width="620" height="80" as="geometry"/></mxCell><mxCell id="v59" value="② The actual pipeline, step by step: the data (left), what the step does (middle), its cost (right)" style="whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#2b4c80;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="1760" height="30" as="geometry"/></mxCell><mxCell id="v60" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#2b4c80;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="772" width="1760" height="2" as="geometry"/></mxCell><mxCell id="v61" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="788" width="1760" height="190" as="geometry"/></mxCell><mxCell id="v62" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Input: 5 records with the labels our data has&lt;/b&gt;&lt;br&gt;&lt;b&gt;Truth:&lt;/b&gt; 1, 2 and 3 are one person; 3 moved to Kawasaki and kept the phone. 4 is a sibling at the same address. 5 is someone else.&lt;br&gt;&lt;br&gt;Real names are kana; romaji here so anyone can read it." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="796" width="520" height="174" as="geometry"/></mxCell><mxCell id="v63" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="796" width="1" height="174" as="geometry"/></mxCell><mxCell id="v64" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;Full pairwise would read every pair:&lt;br&gt;5 × 4 / 2 = &lt;b&gt;10 pairs&lt;/b&gt;." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="796" width="400" height="174" as="geometry"/></mxCell><mxCell id="v65" value="#" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="800" width="28" height="27" as="geometry"/></mxCell><mxCell id="v66" value="Name" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="800" width="92" height="27" as="geometry"/></mxCell><mxCell id="v67" value="Address" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="800" width="270" height="27" as="geometry"/></mxCell><mxCell id="v68" value="Postcode" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="800" width="82" height="27" as="geometry"/></mxCell><mxCell id="v69" 