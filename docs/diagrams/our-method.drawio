;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="5015" width="360" height="28" as="geometry"/></mxCell><mxCell id="v606" value="I" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="5043" width="110" height="28" as="geometry"/></mxCell><mxCell id="v607" value="operations to add one vector to the index" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="5043" width="400" height="28" as="geometry"/></mxCell><mxCell id="v608" value="Which index type and settings?" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="5043" width="360" height="28" as="geometry"/></mxCell><mxCell id="v609" value="Q" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="5071" width="110" height="28" as="geometry"/></mxCell><mxCell id="v610" value="vectors one record is compared with in search" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="5071" width="400" height="28" as="geometry"/></mxCell><mxCell id="v611" value="How many vectors does a query visit?" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="5071" width="360" height="28" as="geometry"/></mxCell><mxCell id="v612" value="k" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="5099" width="110" height="28" as="geometry"/></mxCell><mxCell id="v613" value="neighbours kept per record as candidates" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="5099" width="400" height="28" as="geometry"/></mxCell><mxCell id="v614" value="How many neighbours per record?" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="5099" width="360" height="28" as="geometry"/></mxCell><mxCell id="v615" value="c_decide" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="5127" width="110" height="28" as="geometry"/></mxCell><mxCell id="v616" value="operations to decide one candidate" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1020" y="5127" width="400" height="28" as="geometry"/></mxCell><mxCell id="v617" value="How is “same customer” decided?" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1420" y="5127" width="360" height="28" as="geometry"/></mxCell><mxCell id="v618" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#fffbe8;strokeColor=#d6b656;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="5203" width="1760" height="100" as="geometry"/></mxCell><mxCell id="v619" value="&lt;b&gt;Is the comparison fair yet?&lt;/b&gt;&lt;br&gt;Fair already: the same unit, per record, at the same N, from the same input (one name, one address).&lt;br&gt;&lt;br&gt;Not fair yet: our total runs to a decided score; the embedding total stops at the vectors. Both leave steps out, so both are lower bounds, for different reasons." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="5211" width="860" height="88" as="geometry"/></mxCell><mxCell id="v620" value="&lt;b&gt;Needed on both sides before comparing&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Same end point:&lt;/b&gt; both counted until a decided list of pairs.&lt;br&gt;• &lt;b&gt;Same quality:&lt;/b&gt; both reach the same pairs on the same records, e.g. 99.99% of reviewable pairs with no wrong merges.&lt;br&gt;• &lt;b&gt;One check:&lt;/b&gt; instructions counted on one CPU core, same records, both pipelines, so an operation means the same on both sides." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="910" y="5211" width="860" height="88" as="geometry"/></mxCell><mxCell id="e621" value="−1.37" style="endArrow=none;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="205" as="sourcePoint"/><mxPoint x="370" y="205" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e622" value="−1.37" style="endArrow=none;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="240" as="sourcePoint"/><mxPoint x="235" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e623" value="+11.28 ✓" style="endArrow=none;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="240" as="sourcePoint"/><mxPoint x="305" y="292" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e624" value="1-2 match" style="endArrow=none;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="3288" as="sourcePoint"/><mxPoint x="220" y="3273" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e625" value="1-3 match" style="endArrow=none;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="3313" as="sourcePoint"/><mxPoint x="225" y="3368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e626" value="" style="endArrow=none;dashed=1;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="3308" as="sourcePoint"/><mxPoint x="255" y="3348" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e627" value="" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="3318" as="sourcePoint"/><mxPoint x="460" y="3318" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e628" value="" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445" y="4094" as="sourcePoint"/><mxPoint x="465" y="4094" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e629" value="" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="4094" as="sourcePoint"/><mxPoint x="910" y="4094" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e630" value="" style="endArrow=classic;html=1;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1335" y="4094" as="sourcePoint"/><mxPoint x="1355" y="4094" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>