etry x="480" y="2611" width="130" height="27" as="geometry"/></mxCell><mxCell id="v381" value="2-4" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2638" width="60" height="27" as="geometry"/></mxCell><mxCell id="v382" value="≠" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="2638" width="70" height="27" as="geometry"/></mxCell><mxCell id="v383" value="=" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160" y="2638" width="80" height="27" as="geometry"/></mxCell><mxCell id="v384" value="—" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="2638" width="70" height="27" as="geometry"/></mxCell><mxCell id="v385" value="≠" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="310" y="2638" width="60" height="27" as="geometry"/></mxCell><mxCell id="v386" value="−1.40" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="2638" width="110" height="27" as="geometry"/></mxCell><mxCell id="v387" value="set aside" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#f8d7da;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="2638" width="130" height="27" as="geometry"/></mxCell><mxCell id="v388" value="= same hash number · ≠ different · — missing on one side. 1-4 and 2-4 are the sibling: rightly set aside. 2-3 is set aside here, yet 2 and 3 still end up together (step 8)." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="2678" width="780" height="60" as="geometry"/></mxCell><mxCell id="v389" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="2758" width="1760" height="270" as="geometry"/></mxCell><mxCell id="v390" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;6. Read in full and score&lt;/b&gt;&lt;br&gt;Each label walks down its ladder (step 2), best first; the first level that holds gives its points:&lt;br&gt;• &lt;b&gt;names&lt;/b&gt;: exact, exact without dakuten, same sound, then &lt;b&gt;Jaro-Winkler&lt;/b&gt;: letters matching in nearly the same place, fewer points for order changes, a bonus for the same first 4 letters (0 to 1)&lt;br&gt;• &lt;b&gt;addresses&lt;/b&gt;: exact, then &lt;b&gt;Levenshtein&lt;/b&gt;: the fewest letters added, removed or replaced (≤ 2 is close), then same postcode&lt;br&gt;• &lt;b&gt;phone&lt;/b&gt;: &lt;b&gt;Hamming&lt;/b&gt;, digits that differ in place · &lt;b&gt;customer ID, birth date&lt;/b&gt;: &lt;b&gt;Damerau-Levenshtein&lt;/b&gt;, where two swapped digits count as 1&lt;br&gt;&lt;br&gt;Example (left): two other records where every label is only similar, none exact. All four algorithms run; the points add up to +17.07." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="2766" width="520" height="254" as="geometry"/></mxCell><mxCell id="v391" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="2766" width="1" height="254" as="geometry"/></mxCell><mxCell id="v392" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;Per pair: B²name + B²addr = 1165 byte comparisons at most&lt;br&gt;0.073 × 1165 ≈ 85 per record&lt;br&gt;&lt;br&gt;1M records: &lt;b&gt;0.6 s&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="2766" width="400" height="254" as="geometry"/></mxCell><mxCell id="v393" value="Label" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="2770" width="80" height="28" as="geometry"/></mxCell><mxCell id="v394" value="record A" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="110" y="2770" width="150" height="28" as="geometry"/></mxCell><mxCell id="v395" value="record B" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="2770" width="150" height="28" as="geometry"/></mxCell><mxCell id="v396" value="algorithm → result" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="2770" width="190" height="28" as="geometry"/></mxCell><mxCell id="v397" value="level" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="2770" width="140" height="28" as="geometry"/></mxCell><mxCell id="v398" value="points" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="740" y="2770" width="70" height="28" as="geometry"/></mxCell><mxCell id="v399" value="start" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2798" width="80" height="28" as="geometry"/></mxCell><mxCell id="v400" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="110" y="2798" width="150" height="28" as="geometry"/></mxCell><mxCell id="v401" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="260" y="2798" width="150" height="28" as="geometry"/></mxCell><mxCell id="v402" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxG