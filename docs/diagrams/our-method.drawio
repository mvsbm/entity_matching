/></mxCell><mxCell id="v346" value="0" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="2550" width="80" height="26" as="geometry"/></mxCell><mxCell id="v347" value="total" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2576" width="90" height="26" as="geometry"/></mxCell><mxCell id="v348" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="120" y="2576" width="170" height="26" as="geometry"/></mxCell><mxCell id="v349" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="2576" width="190" height="26" as="geometry"/></mxCell><mxCell id="v350" value="0 or more → saved" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="2576" width="190" height="26" as="geometry"/></mxCell><mxCell id="v351" value="+2.67" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dff0d8;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="2576" width="80" height="26" as="geometry"/></mxCell><mxCell id="v352" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="2648" width="1760" height="170" as="geometry"/></mxCell><mxCell id="v353" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;7. Save, people decide&lt;/b&gt;&lt;br&gt;Every pair at 0 or more → &lt;b&gt;scored/&lt;/b&gt;. The list people check, best first → &lt;b&gt;review.parquet&lt;/b&gt;, each pair with its points, how it was found, and a “maybe one household” mark when it shares an address or phone but the given names or birth dates differ. Answers → &lt;b&gt;decisions/&lt;/b&gt;. Optional merge conditions (points ≥ x, a named rule) merge without waiting." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="2656" width="520" height="154" as="geometry"/></mxCell><mxCell id="v354" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="2656" width="1" height="154" as="geometry"/></mxCell><mxCell id="v355" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;Machine: writing, O(pairs)&lt;br&gt;People: one look per listed pair" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="2656" width="400" height="154" as="geometry"/></mxCell><mxCell id="v356" value="Pair" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="2660" width="70" height="28" as="geometry"/></mxCell><mxCell id="v357" value="points" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="2660" width="80" height="28" as="geometry"/></mxCell><mxCell id="v358" value="found by" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="2660" width="330" height="28" as="geometry"/></mxCell><mxCell id="v359" value="people say" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="2660" width="100" height="28" as="geometry"/></mxCell><mxCell id="v360" value="1-2" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2688" width="70" height="28" as="geometry"/></mxCell><mxCell id="v361" value="+31.75" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="2688" width="80" height="28" as="geometry"/></mxCell><mxCell id="v362" value="rule X1 (customer ID + full name)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="180" y="2688" width="330" height="28" as="geometry"/></mxCell><mxCell id="v363" value="match" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dff0d8;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="510" y="2688" width="100" height="28" as="geometry"/></mxCell><mxCell id="v364" value="1-3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2716" width="70" height="28" as="geometry"/></mxCell><mxCell id="v365" value="+2.67" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="2716" width="80" height="28" as="geometry"/></mxCell><mxCell id="v366" value="tags: name; phone + first letter" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="180" y="2716" width="330" height="28" as="geometry"/></mxCell><mxCell id="v367" value="match" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dff0d8;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="510" y="2716" width="100" height="28" as="geometry"/></mxCell><mxCell id="v368" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="2828" width="1760" height="230" as="geometry"/></mxCell><mxCell id="v369" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;8. Group&lt;/b&gt;&lt;br&gt;Every match is a tie. A customer is every record connected by ties (union-find).&lt;br&gt;&lt;br&gt;2-3 was never scored, yet 2 and 3 are one customer: both are tied to 1. &lt;b&gt;That is how groups of 3 or more form:&lt;/b&gt; each record only needs one good pair into the group. &lt;b&gt;Saved: gold.parquet&lt;/b&gt;, one customer ID per record." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="2836" width="520" height="214" as="geometry"/></mxCell><mxCell id="v370" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="2836" width="1" height="214" as="geometry"/></mxCell><mxCell id="v371" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;O(pairs + N)&lt;br&gt;&lt;br&gt;1M records: &lt;b&gt;0.26 s&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="2836" width="400" height="214" as="geometry"/></mxCell><mxCell id="v372" value="&lt;b&gt;1&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;Ma Sungbin&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e98f8f;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="2868" width="70" height="70" as="geometry"/></mxCell><mxCell id="v373" value="&lt;b&gt;2&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;Ma Sungbin&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e98f8f;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="220" y="2848" width="70" height="70" as="geometry"/></mxCell><mxCell id="v374" value="&lt;b&gt;3&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;Ma Sungbin&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#e98f8f;strokeColor=#666666;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="220" y="2958" width="70" height="70" as="geometry"/></mxCell><mxCell id="v375" value="2-3 never scored" style="whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="265" y="2928" width="120" height="20" as="geometry"/></mxCell><mxCell id="v376" value="#" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="2853" width="60" height="27" as="geometry"/></mxCell><mxCell id="v377" value="customer" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="2853" width="150" height="27" as="geometry"/></mxCell><mxCell id="v378" value="1" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="2880" width="60" height="27" as="geometry"/></mxCell><mxCell id="v379" value="A" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dff0d8;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="2880" width="150" height="27" as="geometry"/></mxCell><mxCell id="v380" value="2" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="2907" width="60" height="27" as="geometry"/></mxCell><mxCell id="v381" value="A" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dff0d8;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="2907" width="150" height="27" as="geometry"/></mxCell><mxCell id="v382" value="3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="2934" width="60" height="27" as="geometry"/></mxCell><mxCell id="v383" value="A" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dff0d8;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="2934" width="150" height="27" as="geometry"/></mxCell><mxCell id="v384" value="4" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="2961" width="60" height="27" as="geometry"/></mxCell><mxCell id="v385" value="B" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="2961" width="150" height="27" as="geometry"/></mxCell><mxCell id="v386" value="5" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="2988" width="60" height="27" as="geometry"/></mxCell><mxCell id="v387" value="C" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="540" y="2988" width="150" height="27" as="geometry"/></mxCell><mxCell id="v388" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="3068" width="1760" height="150" as="geometry"/></mxCell><mxCell id="v389" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;Then: check for misses&lt;/b&gt;&lt;br&gt;&lt;b&gt;probe&lt;/b&gt;: pairs sampled inside groups matches tend to share (same phone, same postal area), scored; good pairs no tag listed are counted and scaled up.&lt;br&gt;&lt;b&gt;gap&lt;/b&gt;: 20,000 sampled records, every way they could agree, checked against what the tags listed. Both go in report.txt." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="3076" width="520" height="134" as="geometry"/></mxCell><mxCell id="v390" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="3076" width="1" height="134" as="geometry"/></mxCell><mxCell id="v391" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;1M records: &lt;b&gt;15.8 s&lt;/b&gt;&lt;br&gt;&lt;br&gt;Whole run on 1M records: &lt;b&gt;31.7 s&lt;/b&gt; on one laptop" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="3076" width="400" height="134" as="geometry"/></mxCell><mxCell id="v392" value="Check" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="3080" width="260" height="28" as="geometry"/></mxCell><mxCell id="v393" value="Reports" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="3080" width="260" height="28" as="geometry"/></mxCell><mxCell id="v394" value="probe (same phone / postal area)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="3108" width="260" height="28" as="geometry"/></mxCell><mxCell id="v395" value="missed good pairs, estimated" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="3108" width="260" height="28" as="geometry"/></mxCell><mxCell id="v396" value="gap (20,000 sampled records)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="3136" width="260" height="28" as="geometry"/></mxCell><mxCell id="v397" value="what the tags lose vs. every pair" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="3136" width="260" height="28" as="geometry"/></mxCell><mxCell id="v398" value="coverage" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="3164" width="260" height="28" as="geometry"/></mxCell><mxCell id="v399" value="score patterns no tag guarantees" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="290" y="3164" width="260" height="28" as="geometry"/></mxCell><mxCell id="v400" value="③ Why we won&#x27;t miss pairs: a true pair only has to share ONE tag, and nothing on the way drops a pair that could reach 0" style="whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#2b4c80;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="3243" width="1760" height="30" as="geometry"/></mxCell><mxCell id="v401" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#2b4c80;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3275" width="1760" height="2" as="geometry"/></mxCell><mxCell id="v402" value="Whatever differs between two records of one person, another tag still matches:" style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="3291" width="800" height="22" as="geometry"/></mxCell><mxCell id="v403" value="What differs between the two records" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="3319" width="330" height="30" as="geometry"/></mxCell><mxCell id="v404" value="Tag that still puts them in one tray" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="3319" width="470" height="30" as="geometry"/></mxCell><mxCell id="v405" value="a letter missing, extra or wrong in the name" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3349" width="330" height="30" as="geometry"/></mxCell><mxCell id="v406" value="name with one letter covered + area" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="3349" width="470" height="30" as="geometry"/></mxCell><mxCell id="v407" value="long vowel written another way (サトー / サトウ)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3379" width="330" height="30" as="geometry"/></mxCell><mxCell id="v408" value="name as it sounds" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="3379" width="470" height="30" as="geometry"/></mxCell><mxCell id="v409" value="dakuten or small kana (ダ / タ, ャ / ヤ)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3409" width="330" height="30" as="geometry"/></mxCell><mxCell id="v410" value="name without dakuten" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="3409" width="470" height="30" as="geometry"/></mxCell><mxCell id="v411" value="family name changed (marriage)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3439" width="330" height="30" as="geometry"/></mxCell><mxCell id="v412" value="given name + postcode / phone; last 3 sounds + phone / postcode / area" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="3439" width="470" height="30" as="geometry"/></mxCell><mxCell id="v413" value="moved house" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3469" width="330" height="30" as="geometry"/></mxCell><mxCell id="v414" value="phone + area / first letter; customer ID; birth date" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="3469" width="470" height="30" as="geometry"/></mxCell><mxCell id="v415" value="phone changed" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3499" width="330" height="30" as="geometry"/></mxCell><mxCell id="v416" value="address + first letter; address code + first letter; name" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="3499" width="470" height="30" as="geometry"/></mxCell><mxCell id="v417" value="a digit wrong in the customer ID or birth date" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3529" width="330" height="30" as="geometry"/></mxCell><mxCell id="v418" value="ID with one digit covered; birth date with one digit covered + prefecture" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="3529" width="470" height="30" as="geometry"/></mxCell><mxCell id="v419" value="company name written differently" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3559" width="330" height="30" as="geometry"/></mxCell><mxCell id="v420" value="company name normalized; company with one letter covered" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="350" y="3559" width="470" height="30" as="geometry"/></mxCell><mxCell id="v421" value="Nothing on the way drops a good pair:" style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="3291" width="520" height="22" as="geometry"/></mxCell><mxCell id="v422" value="&lt;b&gt;1. Hashing never separates equal tags.&lt;/b&gt; Equal values always give equal numbers. Two different values sharing a number only cost one extra check; they never hide a pair.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. The glance only drops what can&#x27;t reach 0.&lt;/b&gt; It assumes the best for everything it hasn&#x27;t read, so its best case is never below the real score.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Big trays aren&#x27;t skipped blindly.&lt;/b&gt; A tray of 64+ records is joined in full if any sampled pair could reach 0.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Uncovered patterns are reported, not hidden.&lt;/b&gt; The run checks each combination of levels that scores 0 or more (e.g. same phone + name close) and lists any that no tag is sure to catch (COVERAGE in report.txt)." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="3319" width="520" height="280" as="geometry"/></mxCell><mxCell id="v423" value="And we measure it:" style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="3291" width="400" height="22" as="geometry"/></mxCell><mxCell id="v424" value="On a generated 1M-record file with known truth, the tags listed &lt;b&gt;99.99%&lt;/b&gt; of the pairs worth reviewing: &lt;b&gt;14 missed out of 99,027&lt;/b&gt;.&lt;br&gt;&lt;br&gt;On a file without truth, probe and gap estimate the misses every run.&lt;br&gt;&lt;br&gt;&lt;b&gt;What can still be missed:&lt;/b&gt; two records of one person that share nothing exactly: a new address, a new phone, a misspelt name, and no customer ID or birth date. On this score card, full pairwise wouldn&#x27;t score those above 0 either." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="3319" width="400" height="280" as="geometry"/></mxCell><mxCell id="v425" value="④ How a customer with 3 or more records is found" style="whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#2b4c80;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="3611" width="1760" height="30" as="geometry"/></mxCell><mxCell id="v426" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#2b4c80;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3643" width="1760" height="2" as="geometry"/></mxCell><mxCell id="v427" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f3f8ff;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="3659" width="425" height="90" as="geometry"/></mxCell><mxCell id="v428" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;1. Many trays per record&lt;/b&gt;&lt;br&gt;Each record writes up to 22 tags, so it sits in many trays at once. Record 1 shares trays with 2, 3 and 4: three candidates." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="28" y="3667" width="409" height="76" as="geometry"/></mxCell><mxCell id="v429" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f3f8ff;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="465" y="3659" width="425" height="90" as="geometry"/></mxCell><mxCell id="v430" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;2. Every pair on its own&lt;/b&gt;&lt;br&gt;Each candidate pair is scored by itself. There is no “best one only”: 1-2 and 1-3 can both reach 0." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="473" y="3667" width="409" height="76" as="geometry"/></mxCell><mxCell id="v431" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f3f8ff;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="910" y="3659" width="425" height="90" as="geometry"/></mxCell><mxCell id="v432" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;3. Ties chain&lt;/b&gt;&lt;br&gt;Matches are ties; a customer is everything connected. 1-2 + 1-3 → {1, 2, 3}, though 2-3 was never scored." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="918" y="3667" width="409" height="76" as="geometry"/></mxCell><mxCell id="v433" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#f3f8ff;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1355" y="3659" width="425" height="90" as="geometry"/></mxCell><mxCell id="v434" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;4. Sure groups join too&lt;/b&gt;&lt;br&gt;A scored pair can join two sure groups: if 1-2 is a sure pair and 1-3 a scored match, all three become one." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1363" y="3667" width="409" height="76" as="geometry"/></mxCell><mxCell id="v435" value="⑤ Number of comparisons: full pairwise vs ours, at PROD size (over 1 billion CONT_IDs)" style="whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#2b4c80;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="3779" width="1760" height="30" as="geometry"/></mxCell><mxCell id="v436" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#2b4c80;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3811" width="1760" height="2" as="geometry"/></mxCell><mxCell id="v437" value="Full pairwise" style="whiteSpace=wrap;html=1;fontSize=15;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="3827" width="820" height="22" as="geometry"/></mxCell><mxCell id="v438" value="Every pair, each read in full (a name is 18 bytes, an address 29 bytes):" style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="3853" width="820" height="40" as="geometry"/></mxCell><mxCell id="v439" value="$$\frac{n(n-1)}{2}\,\big(B_{name}^2 + B_{addr}^2\big) \approx \frac{n^2}{2}\,(18^2 + 29^2) = \frac{n^2}{2}\cdot 1165$$" style="whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3883" width="820" height="44" as="geometry"/></mxCell><mxCell id="v440" value="$$\frac{(10^9)^2}{2}\cdot 1165 = 5.825 \times 10^{20}$$" style="whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="3937" width="820" height="44" as="geometry"/></mxCell><mxCell id="v441" value="&lt;b&gt;T&lt;/b&gt; = 388 bytes of tags per record · &lt;b&gt;H&lt;/b&gt; = 47 bytes hashed per record · &lt;b&gt;p̄&lt;/b&gt; = 2.7 tray pairs per record · &lt;b&gt;g&lt;/b&gt; = 9 number comparisons per tray pair · &lt;b&gt;q̄&lt;/b&gt; = 0.073 full reads per record · &lt;b&gt;S&lt;/b&gt; = 10⁶ sampled pairs for the score card. p̄ and q̄ were measured on a generated 1M-record file." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="3992" width="820" height="70" as="geometry"/></mxCell><mxCell id="v442" value="Ours" style="whiteSpace=wrap;html=1;fontSize=15;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="3827" width="940" height="22" as="geometry"/></mxCell><mxCell id="v443" value="Each record&#x27;s tags, its glance, its few full reads, plus a score card of fixed size:" style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="3853" width="940" height="40" as="geometry"/></mxCell><mxCell id="v444" value="$$C(n) = n\,\big(T + H + \bar{p}\,g + \bar{q}\cdot 1165\big) + S\cdot 1165 = n\,(388 + 47 + 24 + 85) + 10^6\cdot 1165$$" style="whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="3883" width="940" height="44" as="geometry"/></mxCell><mxCell id="v445" value="$$C(n) = 544\,n + 1.165 \times 10^{9} \qquad C(10^9) \approx 5.45 \times 10^{11}$$" style="whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="3937" width="940" height="44" as="geometry"/></mxCell><mxCell id="v446" value="$$\frac{5.825 \times 10^{20}}{5.45 \times 10^{11}} \approx 1.07 \times 10^{9}\;\;\text{: about a billion times fewer}$$" style="whiteSpace=wrap;html=1;fontSize=15;align=center;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="3992" width="940" height="60" as="geometry"/></mxCell><mxCell id="v447" value="⑥ Work per record: what we know, and what we still need (for discussion)" style="whiteSpace=wrap;html=1;fontSize=20;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#2b4c80;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="4077" width="1760" height="30" as="geometry"/></mxCell><mxCell id="v448" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#2b4c80;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="4109" width="1760" height="2" as="geometry"/></mxCell><mxCell id="v449" value="One unit on both sides: &lt;b&gt;elementary operations&lt;/b&gt;. One compare, add or multiply is 1 operation; a multiply-add is 2. Same input on both sides: one name and one address per record. Only the parts we know are filled in." style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="4125" width="1760" height="26" as="geometry"/></mxCell><mxCell id="v450" value="Our work" style="whiteSpace=wrap;html=1;fontSize=15;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="4161" width="870" height="24" as="geometry"/></mxCell><mxCell id="v451" value="$$W_{ours} = 2T + H + \bar{p}\,g + \bar{q}\,c_{pair} + \frac{S\,c_{pair}}{N}$$" style="whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="4187" width="870" height="40" as="geometry"/></mxCell><mxCell id="v452" value="Part" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="4237" width="260" height="28" as="geometry"/></mxCell><mxCell id="v453" value="Formula" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="4237" width="200" height="28" as="geometry"/></mxCell><mxCell id="v454" value="Value" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="4237" width="410" height="28" as="geometry"/></mxCell><mxCell id="v455" value="Write and hash the tags" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="4265" width="260" height="28" as="geometry"/></mxCell><mxCell id="v456" value="2T" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="4265" width="200" height="28" as="geometry"/></mxCell><mxCell id="v457" value="2 × 194 = 388" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="4265" width="410" height="28" as="geometry"/></mxCell><mxCell id="v458" value="Hash each label for the glance" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="4293" width="260" height="28" as="geometry"/></mxCell><mxCell id="v459" value="H" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="4293" width="200" height="28" as="geometry"/></mxCell><mxCell id="v460" value="47" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="4293" width="410" height="28" as="geometry"/></mxCell><mxCell id="v461" value="Glance at the tray pairs" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="4321" width="260" height="28" as="geometry"/></mxCell><mxCell id="v462" value="p̄ · g" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="4321" width="200" height="28" as="geometry"/></mxCell><mxCell id="v463" value="2.7 × 9 = 24" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="4321" width="410" height="28" as="geometry"/></mxCell><mxCell id="v464" value="Read the surviving pairs in full" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="4349" width="260" height="28" as="geometry"/></mxCell><mxCell id="v465" value="q̄ · c_pair" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="4349" width="200" height="28" as="geometry"/></mxCell><mxCell id="v466" value="0.073 × 490 = 36" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="4349" width="410" height="28" as="geometry"/></mxCell><mxCell id="v467" value="Score card, shared by all records" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="4377" width="260" height="28" as="geometry"/></mxCell><mxCell id="v468" value="S · c_pair / N" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="4377" width="200" height="28" as="geometry"/></mxCell><mxCell id="v469" value="10⁶ × 490 / 10⁹ = 0.5" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="4377" width="410" height="28" as="geometry"/></mxCell><mxCell id="v470" value="Total" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="4405" width="260" height="28" as="geometry"/></mxCell><mxCell id="v471" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="4405" width="200" height="28" as="geometry"/></mxCell><mxCell id="v472" value="≈ 500 operations per record" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="4405" width="410" height="28" as="geometry"/></mxCell><mxCell id="v473" value="c_pair ≈ 490: name exact (≤ 7) + Jaro-Winkler 40 checks × 2; address exact (≤ 14) + Levenshtein 65 cells × 6 (1 letter compare, 3 adds, 2 compares). p̄ = 2.7 and q̄ = 0.073 were measured on a generated 1M-record file." style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="4441" width="870" height="64" as="geometry"/></mxCell><mxCell id="v474" value="Embedding work (example model: EmbeddingGemma 2)" style="whiteSpace=wrap;html=1;fontSize=15;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="910" y="4161" width="870" height="24" as="geometry"/></mxCell><mxCell id="v475" value="$$W_{emb} = 2\Big[(T_n + T_a)\,c_{tok} + a\,(T_n^2 + T_a^2)\Big] + \dots$$" style="whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="4187" width="870" height="40" as="geometry"/></mxCell><mxCell id="v476" value="Part" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="4237" width="260" height="40" as="geometry"/></mxCell><mxCell id="v477" value="Formula" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="4237" width="300" height="40" as="geometry"/></mxCell><mxCell id="v478" value="Value" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1470" y="4237" width="310" height="40" as="geometry"/></mxCell><mxCell id="v479" value="Make the name and address vectors" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="4277" width="260" height="40" as="geometry"/></mxCell><mxCell id="v480" value="2[(T_n + T_a) c_tok + a(T_n² + T_a²)]" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1170" y="4277" width="300" height="40" as="geometry"/></mxCell><mxCell id="v481" value="2[(14.3 + 20.6) × 136,708,096&lt;br&gt;+ 57,344 (14.3² + 20.6²)]" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="4277" width="310" height="40" as="geometry"/></mxCell><mxCell id="v482" value="Total so far" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="910" y="4317" width="260" height="40" as="geometry"/></mxCell><mxCell id="v483" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1170" y="4317" width="300" height="40" as="geometry"/></mxCell><mxCell id="v484" value="≈ 9.6 × 10⁹ operations per record" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#eef3fb;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1470" y="4317" width="310" height="40" as="geometry"/></mxCell><mxCell id="v485" value="T_n, T_a: tokens per name and address text, with the model&#x27;s 9 fixed instruction tokens. c_tok: multiply-adds per token through all 24 rounds, from the model&#x27;s config (matches PyTorch&#x27;s own count). a: every token looking at every other token. “…” is search and deciding, still unknown (below)." style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="910" y="4371" width="870" height="64" as="geometry"/></mxCell><mxCell id="v486" value="Discussion points: the numbers still needed" style="whiteSpace=wrap;html=1;fontSize=15;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="4513" width="1760" height="24" as="geometry"/></mxCell><mxCell id="v487" value="Ours (we can measure these)" style="whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="4543" width="870" height="22" as="geometry"/></mxCell><mxCell id="v488" value="Variable" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="4569" width="110" height="28" as="geometry"/></mxCell><mxCell id="v489" value="What it is" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="4569" width="420" height="28" as="geometry"/></mxCell><mxCell id="v490" value="Why it&#x27;s needed" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="4569" width="340" height="28" as="geometry"/></mxCell><mxCell id="v491" value="T₂₂" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eef7ee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="4597" width="110" height="28" as="geometry"/></mxCell><mxCell id="v492" value="tag bytes per record across all 22 tag kinds" style="whiteSpace=wrap;html=1;fontSize=11;align=center;vertical