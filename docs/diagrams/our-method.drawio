lor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="1982" width="120" height="26" as="geometry"/></mxCell><mxCell id="v299" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="510" y="1982" width="120" height="26" as="geometry"/></mxCell><mxCell id="v300" value="0" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="630" y="1982" width="80" height="26" as="geometry"/></mxCell><mxCell id="v301" value="Yellow: the similar-but-not-equal levels, where the algorithms run." style="whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="2012" width="700" height="20" as="geometry"/></mxCell><mxCell id="v302" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="2048" width="1760" height="200" as="geometry"/></mxCell><mxCell id="v303" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;3. Tie the sure ones (12 rules)&lt;/b&gt;&lt;br&gt;Five exact rules (e.g. same customer ID + full name; same name + address code + phone) and seven that allow a small difference once an exact part matches (e.g. name within 2 edits + same address code + phone).&lt;br&gt;&lt;br&gt;A sure pair is scored too, so people see its points. Pairs inside one sure group are not listed again in step 4. In your workspaces a sure pair still waits for people unless a merge condition says otherwise." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="2056" width="520" height="184" as="geometry"/></mxCell><mxCell id="v304" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="2056" width="1" height="184" as="geometry"/></mxCell><mxCell id="v305" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;One hash join per rule:&lt;br&gt;O(N + rule pairs × L²)&lt;br&gt;&lt;br&gt;1M records: &lt;b&gt;1.1 s&lt;/b&gt;,&lt;br&gt;4,954 sure pairs" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="2056" width="400" height="184" as="geometry"/></mxCell><mxCell id="v306" value="Rule" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="2060" width="70" height="27" as="geometry"/></mxCell><mxCell id="v307" value="Must be the same" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="2060" width="230" height="27" as="geometry"/></mxCell><mxCell id="v308" value="Tray" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="2060" width="230" height="27" as="geometry"/></mxCell><mxCell id="v309" value="Result" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="2060" width="120" height="27" as="geometry"/></mxCell><mxCell id="v310" value="X1" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2087" width="70" height="27" as="geometry"/></mxCell><mxCell id="v311" value="customer ID + full name" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="2087" width="230" height="27" as="geometry"/></mxCell><mxCell id="v312" value="10002345 · masungbin" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2087" width="230" height="27" as="geometry"/></mxCell><mxCell id="v313" value="1-2 sure" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#dff0d8;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="2087" width="120" height="27" as="geometry"/></mxCell><mxCell id="v314" value="X4" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2114" width="70" height="27" as="geometry"/></mxCell><mxCell id="v315" value="full name + address code + phone" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="2114" width="230" height="27" as="geometry"/></mxCell><mxCell id="v316" value="(no address code here)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2114" width="230" height="27" as="geometry"/></mxCell><mxCell id="v317" value="—" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="2114" width="120" height="27" as="geometry"/></mxCell><mxCell id="v318" value="F1–F7" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2141" width="70" height="27" as="geometry"/></mxCell><mxCell id="v319" value="…" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="100" y="2141" width="230" height="27" as="geometry"/></mxCell><mxCell id="v320" value="" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2141" width="230" height="27" as="geometry"/></mxCell><mxCell id="v321" value="—" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="560" y="2141" width="120" height="27" as="geometry"/></mxCell><mxCell id="v322" value="1-2 is scored: −23.68 + 18.63 (name) + 16.33 (address) + 20.47 (ID) = &lt;b&gt;+31.75&lt;/b&gt;; record 2 has no phone: 0." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="2180" width="700" height="40" as="geometry"/></mxCell><mxCell id="v323" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="2258" width="1760" height="250" as="geometry"/></mxCell><mxCell id="v324" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;4. Tags → trays&lt;/b&gt;&lt;br&gt;Every record writes up to 22 kinds of tags: name; name without dakuten; name as it sounds; name with one letter covered + area; given name + postcode / address code / phone; last 3 sounds + phone / postcode / area; address + first letter; address code + phone; phone + area / first letter; customer ID; ID with one digit covered; birth date; …&lt;br&gt;&lt;br&gt;Each tag is hashed to a tray number: equal tags always get equal numbers. Only records in one tray become pairs. &lt;b&gt;One record can be in many trays, so it can have many candidates:&lt;/b&gt; record 1 gets 2, 3 and 4." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="2266" width="520" height="234" as="geometry"/></mxCell><mxCell id="v325" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="2266" width="1" height="234" as="geometry"/></mxCell><mxCell id="v326" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;Each record&#x27;s tags written and hashed:&lt;br&gt;T ≈ 388 bytes per record&lt;br&gt;&lt;br&gt;1M records (steps 4–5): &lt;b&gt;3.2 s&lt;/b&gt;,&lt;br&gt;2.74M pairs listed = 2.7 per record" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="2266" width="400" height="234" as="geometry"/></mxCell><mxCell id="v327" value="Tray (tag · value)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="2270" width="300" height="26" as="geometry"/></mxCell><mxCell id="v328" value="Records" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="2270" width="90" height="26" as="geometry"/></mxCell><mxCell id="v329" value="Pairs out" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="2270" width="190" height="26" as="geometry"/></mxCell><mxCell id="v330" value="name · masungbin" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2296" width="300" height="26" as="geometry"/></mxCell><mxCell id="v331" value="1, 2, 3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2296" width="90" height="26" as="geometry"/></mxCell><mxCell id="v332" value="1-2, 1-3, 2-3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="2296" width="190" height="26" as="geometry"/></mxCell><mxCell id="v333" value="name as it sounds · masungbin" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2322" width="300" height="26" as="geometry"/></mxCell><mxCell id="v334" value="1, 2, 3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2322" width="90" height="26" as="geometry"/></mxCell><mxCell id="v335" value="(repeats)" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="2322" width="190" height="26" as="geometry"/></mxCell><mxCell id="v336" value="address + first letter · Hongo 1-2-3 · m" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2348" width="300" height="26" as="geometry"/></mxCell><mxCell id="v337" value="1, 2, 4" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2348" width="90" height="26" as="geometry"/></mxCell><mxCell id="v338" value="1-2, 1-4, 2-4" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="2348" width="190" height="26" as="geometry"/></mxCell><mxCell id="v339" value="phone + first letter · 1234 · m" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2374" width="300" height="26" as="geometry"/></mxCell><mxCell id="v340" value="1, 3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2374" width="90" height="26" as="geometry"/></mxCell><mxCell id="v341" value="1-3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="2374" width="190" height="26" as="geometry"/></mxCell><mxCell id="v342" value="name, one letter covered + area 113" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2400" width="300" height="26" as="geometry"/></mxCell><mxCell id="v343" value="1, 2" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2400" width="90" height="26" as="geometry"/></mxCell><mxCell id="v344" value="1-2" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="2400" width="190" height="26" as="geometry"/></mxCell><mxCell id="v345" value="every other tray" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="2426" width="300" height="26" as="geometry"/></mxCell><mxCell id="v346" value="1 record" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="2426" width="90" height="26" as="geometry"/></mxCell><mxCell id="v347" value="none" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="2426" width="190" height="26" as="geometry"/></mxCell><mxCell id="v348" value="Drop 1-2 (already one sure group), cross out repeats → &lt;b&gt;4 pairs: 1-3, 2-3, 1-4, 2-4&lt;/b&gt;. Record 5 is never paired." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="30" y="2462" width="780" height="40" as="geometry"/></mxCell><mxCell id="v349" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;rounded=1;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="2518" width="1760" height="230" as="geometry"/></mxCell><mxCell id="v350" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;5. Glance (best case first)&lt;/b&gt;&lt;br&gt;Three quick passes, each assuming the &lt;b&gt;best&lt;/b&gt; for whatever it hasn&#x27;t read yet:&lt;br&gt;1. compare each label&#x27;s hash number: equal → maybe the same; different → surely not exactly the same;&lt;br&gt;2. run the cheap comparisons for real: Hamming (phone), Damerau-Levenshtein ≤ 1 (ID, birth date), lengths, and the one slow comparison worth the most (usually the name&#x27;s Jaro-Winkler);&lt;br&gt;3. work out the full best case.&lt;br&gt;&lt;br&gt;A pair is set aside only if even its best case is below 0. So a pair that could reach 0 is never set aside. Big trays from step 1 are joined only if a sample of their pairs could reach 0." style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="2526" width="520" height="214" as="geometry"/></mxCell><mxCell id="v351" value="" style="whiteSpace=wrap;html=1;fontSize=12;align=center;verticalAlign=middle;fillColor=#cccccc;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="2526" width="1" height="214" as="geometry"/></mxCell><mxCell id="v352" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Cost&lt;/b&gt;&lt;br&gt;Per pair: about 9 number comparisons and a few bytes, no full read.&lt;br&gt;&lt;br&gt;1M records: 2.74M pairs → &lt;b&gt;72,932&lt;/b&gt; kept (0.073 per record)" style="whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;fillColor=none;strokeColor=none;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1380" y="2526" width="400" height="214" as="geometry"/></mxCell><mxCell id="v353" value="Pair" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="2530" width="60" height="27" as="geometry"/></mxCell><mxCell id="v354" value="name #" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="2530" width="70" height="27" as="geometry"/></mxCell><mxCell id="v355" value="address #" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="2530" width="80" height="27" as="geometry"/></mxCell><mxCell id="v356" value="phone #" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="2530" width="70" height="27" as="geometry"/></mxCell><mxCell id="v357" value="ID #" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="2530" width="60" height="27" as="geometry"/></mxCell><mxCell id="v358" value="best case" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="2530" width="110" height="27" as="geometry"/></mxCell><mxCell id="v359" value="result" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#eeeeee;strokeColor=#999999;strokeWidth=1;fontColor=#000000;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="2530" width="130" height="27" as="geometry"/></mxCell><mxCell id="v360" value="1-3" style="whiteSpace=wrap;html=1;fontSize=11;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1;fontColor=#0