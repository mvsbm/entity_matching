@startuml components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
title HLD 3 · Components: every module, in its layer; each layer imports only the layers below it

Container(tools_run, "Run-time tools", "nayose", "er/cli.py: every nayose command, its parser and reference\ner/emit.py: a command's events, as JSON or as the steps go for a person\ner/brief.py: a result for a person, in short or every field\ner/hints.py: a file read as the door reads it\nscripts/document_commands.py: docs/commands.md")
Container(tools_design, "Design-time tools", "scripts/", "scripts/generate.py: synthetic data\nscripts/choose.py: the matching chosen\nscripts/choose_kind.py: person or company measured\nscripts/train_name_model.py: config/kind_names.npz\nscripts/benchmark.py: quality and cost\nscripts/benchmark_intake.py: the reader on damaged files\nscripts/benchmark_lookup.py: a record looked up, timed and checked against an increment\nscripts/export_pdfs.py: the demo's PDF")

Component(run, "The run", "er/", "er/run.py: Run, its steps: load, budget, fit, rules, candidates, score, cluster, write, report; increment, decide\ner/folder.py: the workspace: one writer, staged writes, steps.json, part numbers\ner/report.py: the reports for people\ner/review_state.py: what people said of a run: each pair's latest decision\ner/explain.py: a run's model, and its pairs scored again with it\ner/results.py: what a written run holds: its scored pairs, its entities\ner/index.py: the run's keys, indexed and kept up to date: one record looked up")
Component(design, "Design time", "design/", "design/select.py: each change tested and adopted\ndesign/experiments.py: the variants tried, in the order decided\ndesign/pipeline.py: the pipeline measured through er.run, threshold curves\ndesign/evaluate.py: metrics, intervals\ndesign/tune.py: Optuna\ndesign/generate.py: synthetic records and the truth\ndesign/sample.py: records drawn by hash and every pair they could make, scored\ndesign/probe.py: the matches no key lists, sampled\ndesign/gap.py: the gap the keys leave")
Component(steps, "The steps", "er/", "er/source.py: input files\ner/standardize.py: fields and normalized copies\ner/kind.py: person or company\ner/candidates.py: budgets and candidate pairs\ner/match.py: rules, the model, u\ner/fit.py: the model's λ and m, learned\ner/cluster.py: clusters, for every run and design time")
Component(configuration, "Foundation", "er/", "er/config.py: the pipeline's dataclasses, InputError\ner/settings.py: config/settings.toml\ner/intake.py: a Parquet records file as it comes, read into one clean Parquet\ner/io.py: datasets, the leaderboard, tables\ner/strings.py: the connection and cl_* functions")

Rel_D(tools_run, run, "")
Rel_D(tools_run, steps, "")
Rel_D(tools_run, configuration, "")
Rel_D(tools_design, tools_run, "")
Rel_D(tools_design, run, "")
Rel_D(tools_design, design, "")
Rel_D(tools_design, steps, "")
Rel_D(tools_design, configuration, "")
Rel_D(run, steps, "")
Rel_D(run, configuration, "")
Rel_D(design, run, "")
Rel_D(design, steps, "")
Rel_D(design, configuration, "")
Rel_D(steps, configuration, "")

SHOW_LEGEND()
@enduml
