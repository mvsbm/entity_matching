@startuml components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
title 2 · Components: nayose's files, and what calls what

Container(cli, "The jobs, here", "nayose/~__main~__.py", "python -m nayose build | update | match | decide | lookup: a run's folder, its lock, the JSON printed, the exit code")
Container(deploy, "The deploy", "deploy/", "deploy.py: a dataset's functions and procedures · run.py: input loaded, a procedure called · smoke.py: BigQuery against DuckDB · Jenkinsfile · terraform/")
Container(tools, "Design time", "scripts/, design/", "generate.py: synthetic data · benchmark.py: quality and cost · estimate_cost.py: BigQuery's bill, measured on DuckDB · train_name_model.py: config/kind_names.npz")

Component(stages, "Stages and jobs", "nayose/~__init~__.py", "records, fit, score, decide, match, lookup, build, update: each stage file run with its values (values: config.toml); report.txt")
Component(engines, "Engines", "nayose/engines.py", "DuckDB: the SQL translated, the function twins · BigQuery: the SQL as written, a session a job · functions(), procedures(): the deploy's statements")
Component(udfs, "Python UDFs", "nayose/em.py, nayose/entities.py", "fit_model: EM · entities_of: connected components · standard library only, BigQuery's python-3.11")
ComponentDb(sql, "The method", "nayose/sql/*.sql, mapping.sql", "functions, records, fit, score, decide, match, lookup, report: BigQuery's dialect")
ComponentDb(values, "The values", "nayose/config.toml, config/kind_names.npz", "a section a stage; the keys and rules a run uses · the name model")
ComponentDb(js, "The comparisons in JavaScript", "nayose/strings.js", "cl_* as BigQuery runs them")

Rel_D(cli, stages, "calls")
Rel_D(deploy, engines, "BigQuery, functions(), procedures()")
Rel_D(deploy, stages, "values, report_text")
Rel_D(tools, stages, "build, on DuckDB")
Rel_D(stages, sql, "reads")
Rel_D(stages, values, "reads")
Rel_R(stages, engines, "runs each statement on")
Rel_D(engines, udfs, "registers, embeds")
Rel_D(engines, js, "embeds")
Rel_L(engines, sql, "procedures(): every job's statements")

SHOW_LEGEND()
@enduml
