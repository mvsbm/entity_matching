@startuml components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
title HLD 3 · Components: every module, in its layer; each layer imports only the layers below it

Container(tools_run, "The jobs' entry", "python -m er", "er/__main__.py: build, update, match, decide, lookup: the words, the JSON printed, the exit codes")
Container(tools_design, "Design-time tools", "scripts/", "scripts/generate.py: synthetic data\nscripts/train_name_model.py: config/kind_names.npz\nscripts/benchmark.py: quality and cost\nscripts/estimate_cost.py: what a build costs BigQuery, measured on DuckDB")

Component(run, "The run", "er/", "er/jobs/build.py: the full run, one line per step, then its index\ner/jobs/update.py: an increment\ner/jobs/match.py: a match run: the pairs at a threshold people set, as a table for them\ner/jobs/decide.py: people's decisions applied\ner/jobs/index.py: the run's keys, indexed and kept up to date: records looked up\ner/steps/job.py: what every step of a job shares (Job, Log, start, Ran)\ner/steps/load.py: 1, load · er/steps/budget.py: 2, budget · er/steps/fit.py: 3, fit\ner/steps/rules.py: 4, rules · er/steps/candidates.py: 5, candidates · er/steps/score.py: 6, score\ner/steps/cluster.py: 7, cluster · er/steps/write.py: 8, write · er/steps/report.py: 9, report\ner/folder.py: the run's folder: one writer, staged writes, steps.json, part numbers\ner/report.py: the reports for people")
Component(design, "Design time", "design/", "design/generate.py: synthetic records and the truth\ndesign/evaluate.py: metrics, intervals")
Component(steps, "The steps", "er/", "er/source.py: input files, read by the intake for a job\ner/standardize.py: fields and normalized copies\ner/kind.py: person or company\ner/candidates.py: budgets and candidate pairs\ner/match.py: rules, the model, u\ner/fit.py: the model's λ and m, learned\ner/cluster.py: clusters")
Component(configuration, "Foundation", "er/", "er/config.py: the pipeline's dataclasses, InputError\ner/settings.py: config/settings.toml\ner/intake.py: a Parquet records file as it comes, read into one clean Parquet\ner/io.py: files, locks, tables\ner/strings.py: the comparison functions and their scorers\ner/engine/engine.py: what a step asks of an engine\ner/engine/duckdb.py: DuckDB, the connection and cl_* functions\ner/engine/bigquery.py: BigQuery: the SQL translated, a session a job, the functions in JavaScript")

Rel_D(tools_run, run, "")
Rel_D(tools_run, configuration, "")
Rel_D(tools_design, run, "")
Rel_D(tools_design, design, "")
Rel_D(tools_design, steps, "")
Rel_D(tools_design, configuration, "")
Rel_D(run, steps, "")
Rel_D(run, configuration, "")
Rel_D(design, steps, "")
Rel_D(steps, configuration, "")

SHOW_LEGEND()
@enduml
