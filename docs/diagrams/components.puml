@startuml components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
title HLD 3 · Components: every module, in its layer; each layer imports only the layers below it

Container(tools_run, "Run-time tools", "nayose", "er/cli.py: every nayose command, its parser and reference\ner/inbox.py: nayose serve inbox\ner/auto.py: nayose rehearse records, a generated file of the same size, run and measured\ner/ui.py: nayose open ui, the commands in a browser\nscripts/document_commands.py: docs/commands.md")
Container(tools_design, "Design-time tools", "scripts/", "scripts/generate.py: synthetic data\nscripts/choose.py: the matching chosen\nscripts/choose_kind.py: person or company measured\nscripts/train_name_model.py: config/kind_names.npz\nscripts/benchmark.py: quality and cost\nscripts/benchmark_intake.py: the reader on damaged files\nscripts/benchmark_lookup.py: a record looked up, timed and checked against an increment\nscripts/export_pdfs.py: the demo's PDF")

Component(run, "The run", "er/", "er/run.py: Run, its steps: load, budget, fit, rules, candidates, score, cluster, write, report; increment, decide\ner/folder.py: the workspace: one writer, staged writes, steps.json, part numbers\ner/report.py: the reports for people\ner/results.py: what a run holds, for people: its pairs, entities, full rows; merging without a run\ner/details.py: a details file's rows, read from the file itself into each record's full row\ner/index.py: the run's keys and values, indexed and kept up to date: one record looked up, or searched as it is typed")
Component(design, "Design time", "er/", "er/select.py: each change tested and adopted\ner/pipeline.py: the pipeline measured through er.run, threshold curves\ner/evaluate.py: metrics, intervals\ner/tune.py: Optuna\ner/generate.py: synthetic records and the truth")
Component(steps, "The steps", "er/", "er/source.py: input files\ner/standardize.py: fields and normalized copies\ner/kind.py: person or company\ner/candidates.py: budgets and candidate pairs\ner/match.py: rules, the model, u\ner/cluster.py: clusters, for every run and design time\ner/probe.py: the matches no key lists, sampled\ner/keys.py: keys learned on each file, and the gap the keys leave, sampled")
Component(configuration, "Foundation", "er/", "er/config.py: the pipeline's dataclasses, InputError\ner/settings.py: config/settings.toml\ner/intake.py: a records file as it comes, read into Parquet\ner/io.py: datasets, the leaderboard, tables\ner/strings.py: the connection and cl_* functions")

Rel_D(tools_run, run, "")
Rel_D(tools_run, steps, "")
Rel_D(tools_run, configuration, "")
Rel_D(tools_run, design, "")
Rel_D(tools_design, run, "")
Rel_D(tools_design, design, "")
Rel_D(tools_design, steps, "")
Rel_D(tools_design, configuration, "")
Rel_D(run, steps, "")
Rel_D(run, configuration, "")
Rel_D(design, run, "")
Rel_D(design, steps, "")
Rel_D(design, configuration, "")
Rel_D(steps, configuration, "")

SHOW_LEGEND()
@enduml
