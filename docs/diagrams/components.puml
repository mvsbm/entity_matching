@startuml components
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 70
title HLD 3 · Components: every module of er/ and the scripts, and every import between them

Container_Boundary(scripts, "scripts/: the entry points") {
  Component(s_resolve, "scripts/resolve.py", "script", "full run, increment, decisions")
  Component(s_schedule, "scripts/schedule.py", "script", "the inbox, through resolve.py")
  Component(s_generate, "scripts/generate.py", "script", "synthetic data")
  Component(s_choose, "scripts/choose.py", "script", "the matching, chosen")
  Component(s_choose_kind, "scripts/choose_kind.py", "script", "person or company, measured")
  Component(s_benchmark, "scripts/benchmark.py", "script", "quality and cost")
  Component(s_export_pdfs, "scripts/export_pdfs.py", "script", "the demo's PDF")
}

Container_Boundary(er, "er/: the engine") {
  Boundary(layer0, "the run") {
    Component(run, "er/run.py", "module", "Run: load, budget, fit, rules, candidates, score, cluster, write, report; increment, decide; qa, report_text")
    Component(pipeline, "er/pipeline.py", "module", "the design-time cascade on pandas frames; preflight; threshold curves; pattern_coverage")
  }
  Boundary(layer1, "design time") {
    Component(select, "er/select.py", "module", "RulesChooser, FSChooser: each change A/B tested, adopted by the decision rule")
    Component(tune, "er/tune.py", "module", "Optuna studies and their dashboard")
    Component(evaluate, "er/evaluate.py", "module", "pair and cluster metrics, Wilson intervals, the paired test")
    Component(generate, "er/generate.py", "module", "synthetic records and the truth; kind_problems; the name model's training split")
  }
  Boundary(layer2, "the steps") {
    Component(source, "er/source.py", "module", "the one door for input files: Parquet found, checked, read by column name")
    Component(standardize, "er/standardize.py", "module", "fields built from columns, normalized copies, each record's kind and routing")
    Component(kind, "er/kind.py", "module", "person or company: legal forms, the name model, the combiner, the lines, the review sheet")
    Component(candidates, "er/candidates.py", "module", "the budget's counts; every candidate generator as SQL; oversized blocks gated")
    Component(match, "er/match.py", "module", "rule joins; Fellegi-Sunter training and scoring through Splink; u from the file")
    Component(cluster, "er/cluster.py", "module", "connected components or the constrained resolver, on pandas frames (design time)")
    Component(strings, "er/strings.py", "module", "the DuckDB connection and its character-level cl_* functions")
  }
  Boundary(layer3, "configuration") {
    Component(config, "er/config.py", "module", "the pipeline's dataclasses, load and dump, restrict to a file's fields; InputError")
    Component(settings, "er/settings.py", "module", "config/settings.toml: paths, [columns], [locale], fit_to_file")
    Component(io, "er/io.py", "module", "datasets, the leaderboard, markdown tables")
  }
}

' every import, as tests/test_design.py finds it in the code
