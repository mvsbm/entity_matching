@startuml increment
title LLD 2 · An increment: Run.increment, its reports written with it (nayose add records … ~--run …)
skinparam defaultFontSize 11
skinparam rectangle {
  BackgroundColor #F4F6F8
  BorderColor #65717E
}
skinparam database {
  BackgroundColor #E8F1FB
  BorderColor #2C6DB3
}
skinparam file {
  BackgroundColor #FFF8E6
  BorderColor #B07D00
}

package "read back from the run folder" {
  file "state/model.json · state/scoring.json" as f_model
  file "state/records/part-n.parquet" as f_records
  file "state/rule_clusters.parquet · gold.parquet" as f_clusters
  file "kind_answers/part-n.parquet" as f_answers
  file "review.parquet · decisions/part-n.parquet" as f_sheet
}
file "the batch: Parquet files (~--input)" as f_batch


rectangle "<b>1 · Load</b>: read the batch beside the stored records; a record already in the run is set aside\n<i>O(Δ·L)</i>\n<size:10><color:#65717E>Run.increment · Run._join · folder.finish_writes · Run._answers · folder.answer_parts · Run._given · kind.merge_answers</color></size>\n<size:10><color:#65717E>Run.load · source.open_source · source.suggest · settings.present_fields · settings.fit_to_file</color></size>\n<size:10><color:#65717E>Run._set_aside · Run._set_aside_in_order · kind.classifier · source.answers · source.known · standardize.prepare · source.file_facts</color></size>" as load
rectangle "<b>2 · Refresh u</b>: join the stored records and the batch; count u again, sample it again only where it drifted\n<i>O(N + S·K_stale)</i>\n<size:10><color:#65717E>match.refreshed_u</color></size>" as fit
package "every matching step reads records" as matching {
  rectangle "<b>3 · Rules</b>: join the batch against every record; merge into the stored clusters\n<i>O(Δ·Σb) + a scan</i>\n<size:10><color:#65717E>Run._rules · Run._untrusted · match.rule_edges · cluster.merge</color></size>" as rules
  rectangle "<b>4 · Candidates</b>: list only the pairs that touch the batch\n<i>O(Δ·Σb) + a scan</i>\n<size:10><color:#65717E>candidates.candidates · run.listed · Run._gate · match.score_fs · Run._gated</color></size>\n<size:10><color:#65717E>match.review_floor · Run.capacity · Run.spill_room · run.size_bytes</color></size>" as candidates
  rectangle "<b>5 · Score</b>: score those pairs, on the records they touch\n<i>O(C_Δ·K·L²)</i>\n<size:10><color:#65717E>match.score_fs</color></size>" as score
  rectangle "<b>6 · Cluster</b>: accept and merge into the stored clusters, each one node; stored answers stand\n<i>O(C_Δ + touched clusters)</i>\n<size:10><color:#65717E>Run._accept · Run.scored · match.named_sql · cluster.merge · Run._gold · run.customer_kinds · Run._expected_false</color></size>" as cluster
}
rectangle "<b>7 · Write</b>: add the new parts; rewrite gold and the rules' clusters\n<i>O(Δ + C_Δ) + O(N)</i>\n<size:10><color:#65717E>Run.write · folder.next_part · folder.stage · folder.finish_writes · Run._log · folder.log · io.code_version</color></size>" as write
rectangle "<b>8 · Report</b>: as a full run's, saved with the batch (7); the previous sheet's open rows stay (report.carry_over)\n<i>O(review pairs)</i>\n<size:10><color:#65717E>Run.report · report.qa · report.report_text</color></size>" as report
database "old_records" as old_records
database "new_records" as new_records
database "set_aside" as set_aside
database "records" as records
database "new_ids" as new_ids
database "rule_clusters" as rule_clusters
database "rule_kept" as rule_kept
database "cands" as cands
database "scores" as scores
database "matches" as matches
database "gold" as gold

package "written to the run folder" {
  file "new parts: matches/, rule_kept/, state/records/, set_aside/\nrewritten: gold.parquet, state/rule_clusters.parquet, state/scoring.json\nsteps.json: an entry added" as f_out
  file "qa.md · report.txt · review.parquet" as f_people
}

f_batch --> load
f_records --> load
f_answers --> load
f_model --> fit
f_clusters --> rules
f_clusters --> cluster
f_sheet --> report

load ..> fit
fit ..> rules
rules ..> candidates
candidates ..> score
score ..> cluster
cluster ..> write
write ..> report : built first, saved together

load --> old_records
load --> new_records
load --> set_aside
old_records --> fit
new_records --> fit
fit --> records
fit --> new_ids
records --> matching
new_records --> rules
new_ids --> rules
rules --> rule_clusters
rules --> rule_kept
new_ids --> candidates
candidates --> cands
cands --> score
score --> scores
new_ids --> cluster
rule_clusters --> cluster
rule_kept --> cluster
cands --> cluster
scores --> cluster
cluster --> matches
cluster --> gold
new_records --> write
rule_clusters --> write
rule_kept --> write
matches --> write
gold --> write
set_aside --> write
records --> report
cands --> report
scores --> report
matches --> report
gold --> report
set_aside --> report

write --> f_out
report --> f_people
legend right
  box: a step, what it does, its cost, and the code it runs
  cylinder: a working table · note: a file
  solid arrow: makes or uses · dashed arrow: runs next
endlegend
@enduml
