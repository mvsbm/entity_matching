@startuml kind
title LLD 4 · Person or company: trained once at design time, applied in every chunk
skinparam defaultFontSize 11
skinparam rectangle {
  BackgroundColor #F4F6F8
  BorderColor #65717E
}
skinparam database {
  BackgroundColor #E8F1FB
  BorderColor #2C6DB3
}
skinparam file {
  BackgroundColor #FFF8E6
  BorderColor #B07D00
}

package "the name model: public data only, trained once by scripts/train_name_model.py, at design time" {
  file "data/reference/individual.json · data/reference/registry.json" as f_ref
  file "config/generator.toml: kana_confusions, branches" as f_gen
  rectangle "generate.name_model_split\nhalf the personas; the companies of Miyagi and Okayama (Fukuoka's held out)" as split
  rectangle "generate.kind_training_names\nevery company as banks write it (generate.bank_name), every persona twice" as names
  rectangle "generate.train_name_model · NameModel.fit\nlogistic regression on the character n-grams of kind.text, n from 1 to 3\n(folded, no spaces, no legal form); scored in DuckDB: NameModel.logit" as model
  file "config/kind_names.npz, tracked in git\nunder kind.name_key: the settings it was trained under" as f_cache
}
rectangle "kind.name_model: every run loads it, never trains it;\nunder other settings it stops, with what to fix" as load

rectangle "kind.classifier\nthe name model, the legal forms (kind.legal) and the flag's values;\n[kind] name_line and trust_flag" as fit

package "every chunk of the load (LLD 1, step 1)" {
  rectangle "standardize.prepare → Classifier.classify\nkind: the engine's sure call (a legal form written, or a name past name_line either way, never a person's against a company flag), else the flag, else 0 not sure;\nwith trust_flag, the flag as it is\nkind_p, kind_by (engine or flag), name_p, kind_flagged (sure against the flag: matched as the engine says), kind_name\nthe name routed by its kind: person_name and full_name for a person, company_name for a company; not sure, where kind_p leans" as classify
  database "records" as records
}

rectangle "steps.cluster.gold_sql · steps.cluster.customer_kinds\neach record's kind; each customer's: 2 if any record is surely 2,\n1 if none leans company and one is surely 1, else 0" as gold
file "gold.parquet" as f_gold

f_ref --> split
split --> names
f_gen --> names
names --> model
model --> f_cache
f_cache --> load
load --> fit
fit --> classify
classify --> records
records --> gold
gold --> f_gold
@enduml
